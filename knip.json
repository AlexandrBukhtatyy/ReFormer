{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    ".",
    "projects/*",
    "projects/reformer-builder-playground/.ui_builder/plugins/*",
    "projects/reformer-builder-playground/.ui_builder/plugins/*/*"
  ],
  "workspaces": {
    "packages/reformer": {
      "entry": [
        "src/model/index.ts",
        "src/form/behaviors/index.ts",
        "src/form/validation/index.ts",
        "src/form/validators/*.ts",
        "src/locale/*.ts"
      ]
    }
  }
}
