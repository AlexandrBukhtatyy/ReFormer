// steps/step-3/form.validation.ts — валидация шага «Шаг 3». «Далее» проверяет только эти
// правила, отправка — все шаги сразу. МОК: required выведены из схемы, допишите правила.
// Пишется один раз и при регенерации не затирается.

import { validate, defineValidationSchema } from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
import type { ZayavkaNaKreditForm } from '../../types';

export const stepValidation = defineValidationSchema<ZayavkaNaKreditForm>(({ model }) => {
  validate(model.$.note, [required({ message: 'Обязательное поле' })]);
});
