<% if (it.rules.validationCode !== null) { -%>
<%~ it.rules.validationCode -%>
<% } else if (it.stepValidation !== null) { -%>
<% const sv = it.stepValidation; -%>
// form.validation.ts — валидация модели визарда. Правила шагов — в steps/<шаг>/form.validation.ts,
// здесь их сборка и поля вне шагов. Пишется один раз и при регенерации не затирается.

import { type FormModel } from '@reformer/core';
<% if (sv.rest.length > 0) { -%>
import { apply, validate, defineValidationSchema, validateModel } from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
<% } else { -%>
import { apply, defineValidationSchema, validateModel } from '@reformer/core/validation';
<% } -%>
import { stepValidations } from '<%= it.layout.imports.steps %>';
import type { <%= it.names.TypeName %> } from '<%= it.layout.imports.types %>';

type Root = <%= it.names.TypeName %>;

/** Полная проверка (отправка): правила всех шагов<%= sv.rest.length > 0 ? ' и поля вне шагов' : '' %>. */
<% if (sv.rest.length > 0) { -%>
export const formValidation = defineValidationSchema<Root>(({ model }) => {
  apply(...stepValidations);
<% for (const path of sv.rest) { -%>
  validate(model.$.<%= path %>, [required({ message: 'Обязательное поле' })]);
<% } -%>
});
<% } else { -%>
export const formValidation = defineValidationSchema<Root>(() => {
  apply(...stepValidations);
});
<% } -%>

/**
 * Пошаговый контракт визарда (`FormWizard` → `config`). `touch: true` обязателен: киты показывают
 * ошибку только у тронутого поля, и без него остановленный шаг выглядел бы как неработающая кнопка.
 */
export function makeValidationConfig(model: FormModel<Root>) {
  return {
    validateStep: (step: number): Promise<boolean> => {
      const schema = stepValidations[step - 1];
      return schema === undefined
        ? Promise.resolve(true)
        : validateModel(model, schema, { touch: true });
    },
    validateAll: (): Promise<boolean> => validateModel(model, formValidation, { touch: true }),
  };
}
<% } else { -%>
// form.validation.ts — валидация модели. МОК: required выведены из схемы, допишите правила.
// Пишется один раз и при регенерации не затирается.

import { type FormModel } from '@reformer/core';
<% if (it.required.length > 0) { -%>
import { validate, defineValidationSchema, validateModel } from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
<% } else { -%>
import { defineValidationSchema, validateModel } from '@reformer/core/validation';
<% } -%>
import type { <%= it.names.TypeName %> } from '<%= it.layout.imports.types %>';

type Root = <%= it.names.TypeName %>;

<% if (it.required.length > 0) { -%>
export const formValidation = defineValidationSchema<Root>(({ model }) => {
<% for (const path of it.required) { -%>
    validate(model.$.<%= path %>, [required({ message: 'Обязательное поле' })]);
<% } -%>
  });
<% } else { -%>
export const formValidation = defineValidationSchema<Root>(() => {
    // TODO: правила валидации
  });
<% } -%>

/** Пошаговый контракт визарда. Полная проверка — validateModel(model, formValidation). */
export function makeValidationConfig(model: FormModel<Root>) {
  return {
    validateStep: (_step: number): Promise<boolean> => validateModel(model, formValidation),
    validateAll: (): Promise<boolean> => validateModel(model, formValidation),
  };
}
<% } -%>
