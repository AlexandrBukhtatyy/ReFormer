// renderer.behavior.ts — рантайм-обвязка (submit, условная видимость, события узлов).

import { <%= it.renderBehavior.imports.join(', ') %>, type RenderBehaviorFn } from '@reformer/renderer-react';
import { validateModel } from '@reformer/core/validation';
import type { FormModel, FormProxy } from '@reformer/core';
import { formValidation } from './validation';
import { submitForm } from './api';
import type { <%= it.names.TypeName %> } from './types';

export type RenderBehaviorOptions = { onResult?: (message: string, ok: boolean) => void };

export function createJsonRenderBehavior(
  form: FormProxy<<%= it.names.TypeName %>>,
  model: FormModel<<%= it.names.TypeName %>>,
  options: RenderBehaviorOptions = {}
): RenderBehaviorFn<<%= it.names.TypeName %>> {
  const { onResult } = options;
  return (schema) => {
    void form; // используется в условиях hideWhen (form.<поле>.value.value)
<% if (it.renderBehavior.voidHideWhen) { -%>
    void hideWhen;
<% } -%>

    const <%= it.renderBehavior.target %> = schema.node('<%= it.selectors.submitSelector %>');
<% if (it.renderBehavior.isWizard) { -%>

    // Визард — self-managed компонент: форму ему передаём явно.
    onInit(<%= it.renderBehavior.target %>, () => <%= it.renderBehavior.target %>.patchProps({ form }));
<% } -%>

    onComponentEvent(<%= it.renderBehavior.target %>, '<%= it.selectors.submitEvent %>', async () => {
      // `touch: true` обязателен: киты показывают ошибку только у ТРОНУТОГО поля
      // (`invalid && (touched || dirty)`). Без него неудачная отправка выглядела бы так,
      // будто кнопка не работает: форма не отправлена, а почему — нигде не сказано.
      if (!(await validateModel(model, formValidation, { touch: true }))) {
        onResult?.('Проверьте заполнение формы', false);
        return;
      }
      const res = await submitForm(model.get());
      onResult?.(res.success ? 'Форма отправлена' : res.error, res.success);
    });
<% if (it.renderBehavior.rules.length > 0) { %>
    // Правила render-слоя (из правил формы — правьте здесь или в панели правил):
<% for (const rule of it.renderBehavior.rules) { -%>
<%~ it.indent(rule.lines, 4) %>
<% } -%>
<% } -%>
<% if (it.renderBehavior.scaffold.length > 0) { %>
    // Условная видимость секций — раскомментируйте и впишите условие:
<% for (const s of it.renderBehavior.scaffold) { -%>
    // hideWhen(schema.node('<%= s.selector %>'), () => /* TODO: условие для «<%= s.label %>» */ false);
<% } -%>
<% } -%>
  };
}
