{
  "name": "@reformer/builder",
  "version": "0.0.0",
  "description": "Visual form-schema builder for the @reformer ecosystem — a bundled offline SPA you run via npx; configured by the .ui_builder/ directory, extended by plugins",
  "type": "module",
  "bin": {
    "reformer-builder": "./bin/reformer-builder.mjs"
  },
  "main": "./client/index.js",
  "module": "./client/index.js",
  "types": "./client/index.d.ts",
  "exports": {
    ".": {
      "types": "./client/index.d.ts",
      "import": "./client/index.js"
    },
    "./noop": {
      "types": "./client/noop.d.ts",
      "import": "./client/noop.js"
    },
    "./vite": {
      "types": "./vite/plugin.d.mts",
      "default": "./vite/plugin.mjs"
    },
    "./runtime-config.schema.json": "./runtime-config.schema.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "vite",
    "client",
    "application-plugins.embedded.json",
    "runtime-config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:client",
    "build:client": "vite build -c vite.client.config.ts",
    "build:plugins": "node scripts/collect-application-plugins.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:browser": "node ../../scripts/run-vitest.mjs -c vitest.browser.config.ts",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "reformer",
    "form-builder",
    "schema-builder",
    "json-schema",
    "forms",
    "react",
    "visual-editor",
    "low-code",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "projects/reformer-builder"
  },
  "homepage": "https://alexandrbukhtatyy.github.io/ReFormer/builder/",
  "bugs": {
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vite": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@preact/signals-core": "^1.8.0",
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-toolkit": "*",
    "@reformer/cdk": "*",
    "@reformer/core": "*",
    "@reformer/form-registry": "*",
    "@reformer/renderer-json": "*",
    "@reformer/renderer-react": "*",
    "@reformer/ui-kit": "*",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.0.15",
    "@vitest/browser-playwright": "^4.0.15",
    "cmdk": "^1.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.553.0",
    "prettier": "^3.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  }
}
