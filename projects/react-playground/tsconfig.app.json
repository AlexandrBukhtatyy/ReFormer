{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* For shadcn */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@builder-src/*": ["../reformer-builder/src/*"],
      "@/shell/*": ["../reformer-builder/src/shell/*"]
    }
  },
  "include": [
    "src",
    "../../packages/reformer-ui-kit/src/lib",
    "../reformer-builder/src/shell/platform/modules",
    "../reformer-builder/src/shell/platform/plugin/typescript-transpiler.ts",
    "../reformer-builder/src/shell/platform/primitives/disposable.ts",
    "../reformer-builder/src/lib/form-fixture",
    "../reformer-builder/src/lib/form-inspect",
    "../reformer-builder/src/lib/form-mock"
  ],
  "exclude": ["src/mocks/_generated"]
}
