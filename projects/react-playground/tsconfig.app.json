{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* For shadcn */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@builder-src/*": ["../reformer-builder/src/*"],
      "@reformer-domain/*": ["../reformer-builder-playground/.ui_builder/plugins/reformer/*"],
      "@/shell/*": ["../reformer-builder/src/shell/*"],
      // Исходники билдера, включённые ниже, импортируют пакет контракта плагинов.
      "@reformer/builder-plugin-api": ["../../packages/reformer-builder-plugin-api/src/index.ts"],
      "@reformer/builder-plugin-api/internal": [
        "../../packages/reformer-builder-plugin-api/src/internal.ts"
      ],
      // Помощники печати — в исходники тем же доводом, что и контракт плагинов выше.
      "@reformer/builder-toolkit": ["../../packages/reformer-builder-toolkit/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/reformer-ui-kit/src/lib",
    "../reformer-builder/src/shell/platform/modules",
    "../reformer-builder/src/shell/platform/plugin/typescript-transpiler.ts",
    "../../packages/reformer-builder-plugin-api/src/primitives/disposable.ts",
    // Данные формы (фикстура, мок, инспектор модели) — ядро домена ReFormer: оно лежит
    // в каталоге плагинов проекта-образца билдера.
    "../reformer-builder-playground/.ui_builder/plugins/reformer/core/form-fixture",
    "../reformer-builder-playground/.ui_builder/plugins/reformer/core/form-inspect",
    "../reformer-builder-playground/.ui_builder/plugins/reformer/core/form-mock"
  ],
  "exclude": ["src/mocks/_generated"]
}
