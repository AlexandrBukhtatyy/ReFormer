{
  "format": 2,
  "version": "1.0",
  "root": {
    "selector": "wizard",
    "component": "$component(Wizard)",
    "componentProps": {
      "className": "bg-white p-8 rounded-lg shadow-md"
    },
    "children": [
      {
        "component": "$component(Step)",
        "componentProps": {
          "title": "Кредит",
          "icon": "💰"
        },
        "children": [
          {
            "component": "$component(Box)",
            "componentProps": {
              "className": "space-y-4"
            },
            "children": [
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Параметры кредита"
                },
                "children": [
                  {
                    "model": "$model(loanType)",
                    "component": "$component(Select)",
                    "componentProps": {
                      "label": "Тип кредита",
                      "testId": "loanType",
                      "options": "$dataSource(LOAN_TYPES)"
                    }
                  },
                  {
                    "model": "$model(loanAmount)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Сумма кредита (₽)",
                      "testId": "loanAmount",
                      "step": 10000,
                      "placeholder": "Введите сумму"
                    }
                  },
                  {
                    "model": "$model(loanTerm)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Срок кредита (месяцев)",
                      "testId": "loanTerm",
                      "placeholder": "Введите срок"
                    }
                  },
                  {
                    "model": "$model(loanPurpose)",
                    "component": "$component(Textarea)",
                    "componentProps": {
                      "label": "Цель кредита",
                      "testId": "loanPurpose",
                      "rows": 3,
                      "placeholder": "Опишите, на что планируете потратить средства"
                    }
                  },
                  {
                    "model": "$model(interestRate)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Процентная ставка (%)",
                      "testId": "interestRate",
                      "disabled": true
                    }
                  },
                  {
                    "model": "$model(monthlyPayment)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Ежемесячный платёж (₽)",
                      "testId": "monthlyPayment",
                      "disabled": true
                    }
                  }
                ]
              },
              {
                "selector": "mortgage-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Ипотека"
                },
                "children": [
                  {
                    "model": "$model(propertyValue)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Стоимость недвижимости (₽)",
                      "testId": "propertyValue",
                      "placeholder": "Введите стоимость"
                    }
                  },
                  {
                    "model": "$model(initialPayment)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Первоначальный взнос (₽)",
                      "testId": "initialPayment",
                      "disabled": true
                    }
                  }
                ]
              },
              {
                "selector": "car-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Автокредит"
                },
                "children": [
                  {
                    "model": "$model(carBrand)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Марка автомобиля",
                      "testId": "carBrand",
                      "placeholder": "Например: Toyota"
                    }
                  },
                  {
                    "model": "$model(carModel)",
                    "component": "$component(Select)",
                    "componentProps": {
                      "label": "Модель автомобиля",
                      "testId": "carModel",
                      "options": [],
                      "placeholder": "Выберите марку"
                    }
                  },
                  {
                    "model": "$model(carYear)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Год выпуска",
                      "testId": "carYear",
                      "min": 2000,
                      "max": "$dataSource(CURRENT_YEAR_PLUS_ONE)",
                      "placeholder": "2020"
                    }
                  },
                  {
                    "model": "$model(carPrice)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Стоимость автомобиля (₽)",
                      "testId": "carPrice",
                      "placeholder": "Введите стоимость"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "$component(Step)",
        "componentProps": {
          "title": "Данные",
          "icon": "🧑"
        },
        "children": [
          {
            "component": "$component(Box)",
            "componentProps": {
              "className": "space-y-4"
            },
            "children": [
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Личные данные"
                },
                "children": [
                  {
                    "model": "$model(personalData.lastName)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Фамилия",
                      "testId": "personalData-lastName",
                      "placeholder": "Введите фамилию"
                    }
                  },
                  {
                    "model": "$model(personalData.firstName)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Имя",
                      "testId": "personalData-firstName",
                      "placeholder": "Введите имя"
                    }
                  },
                  {
                    "model": "$model(personalData.middleName)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Отчество",
                      "testId": "personalData-middleName",
                      "placeholder": "Введите отчество"
                    }
                  },
                  {
                    "model": "$model(personalData.birthDate)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Дата рождения",
                      "testId": "personalData-birthDate",
                      "type": "date"
                    }
                  },
                  {
                    "model": "$model(personalData.gender)",
                    "component": "$component(RadioGroup)",
                    "componentProps": {
                      "label": "Пол",
                      "testId": "personalData-gender",
                      "options": "$dataSource(GENDERS)"
                    }
                  },
                  {
                    "model": "$model(personalData.birthPlace)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Место рождения",
                      "testId": "personalData-birthPlace",
                      "placeholder": "Введите место рождения"
                    }
                  },
                  {
                    "model": "$model(fullName)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Полное имя",
                      "testId": "fullName",
                      "disabled": true
                    }
                  },
                  {
                    "model": "$model(age)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Возраст (лет)",
                      "testId": "age",
                      "disabled": true
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Паспортные данные"
                },
                "children": [
                  {
                    "model": "$model(passportData.series)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Серия паспорта",
                      "testId": "passportData-series",
                      "mask": "99 99",
                      "placeholder": "12 34"
                    }
                  },
                  {
                    "model": "$model(passportData.number)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Номер паспорта",
                      "testId": "passportData-number",
                      "mask": "999999",
                      "placeholder": "123456"
                    }
                  },
                  {
                    "model": "$model(passportData.issueDate)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Дата выдачи",
                      "testId": "passportData-issueDate",
                      "type": "date"
                    }
                  },
                  {
                    "model": "$model(passportData.issuedBy)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Кем выдан",
                      "testId": "passportData-issuedBy",
                      "placeholder": "Введите название органа"
                    }
                  },
                  {
                    "model": "$model(passportData.departmentCode)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Код подразделения",
                      "testId": "passportData-departmentCode",
                      "mask": "999-999",
                      "placeholder": "123-456"
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Документы"
                },
                "children": [
                  {
                    "model": "$model(inn)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "ИНН",
                      "testId": "inn",
                      "mask": "999999999999",
                      "placeholder": "123456789012"
                    }
                  },
                  {
                    "model": "$model(snils)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "СНИЛС",
                      "testId": "snils",
                      "mask": "999-999-999 99",
                      "placeholder": "123-456-789 00"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "$component(Step)",
        "componentProps": {
          "title": "Контакты",
          "icon": "📞"
        },
        "children": [
          {
            "component": "$component(Box)",
            "componentProps": {
              "className": "space-y-4"
            },
            "children": [
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Связь"
                },
                "children": [
                  {
                    "model": "$model(phoneMain)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Основной телефон",
                      "testId": "phoneMain",
                      "mask": "+7 (999) 999-99-99",
                      "placeholder": "+7 (___) ___-__-__"
                    }
                  },
                  {
                    "model": "$model(phoneAdditional)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Дополнительный телефон",
                      "testId": "phoneAdditional",
                      "mask": "+7 (999) 999-99-99",
                      "placeholder": "+7 (___) ___-__-__"
                    }
                  },
                  {
                    "model": "$model(email)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Email",
                      "testId": "email",
                      "type": "email",
                      "placeholder": "example@mail.com"
                    }
                  },
                  {
                    "model": "$model(sameEmail)",
                    "component": "$component(Checkbox)",
                    "componentProps": {
                      "label": "Дополнительный email совпадает с основным",
                      "testId": "sameEmail"
                    }
                  },
                  {
                    "model": "$model(emailAdditional)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Дополнительный email",
                      "testId": "emailAdditional",
                      "type": "email",
                      "placeholder": "example@mail.com"
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Адрес регистрации"
                },
                "children": [
                  {
                    "model": "$model(registrationAddress.region)",
                    "component": "$component(Select)",
                    "componentProps": {
                      "label": "Регион",
                      "testId": "registrationAddress-region",
                      "options": "$dataSource(REGIONS)"
                    }
                  },
                  {
                    "model": "$model(registrationAddress.city)",
                    "component": "$component(Select)",
                    "componentProps": {
                      "label": "Город",
                      "testId": "registrationAddress-city",
                      "options": [],
                      "placeholder": "Выберите регион"
                    }
                  },
                  {
                    "model": "$model(registrationAddress.street)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Улица",
                      "testId": "registrationAddress-street",
                      "placeholder": "Введите улицу"
                    }
                  },
                  {
                    "model": "$model(registrationAddress.house)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Дом",
                      "testId": "registrationAddress-house",
                      "placeholder": "№"
                    }
                  },
                  {
                    "model": "$model(registrationAddress.apartment)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Квартира",
                      "testId": "registrationAddress-apartment",
                      "placeholder": "№"
                    }
                  },
                  {
                    "model": "$model(registrationAddress.postalCode)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Индекс",
                      "testId": "registrationAddress-postalCode",
                      "mask": "999999",
                      "placeholder": "000000"
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Адрес проживания"
                },
                "children": [
                  {
                    "model": "$model(sameAsRegistration)",
                    "component": "$component(Checkbox)",
                    "componentProps": {
                      "label": "Совпадает с адресом регистрации",
                      "testId": "sameAsRegistration"
                    }
                  },
                  {
                    "selector": "residence-section",
                    "component": "$component(Section)",
                    "componentProps": {
                      "title": "Фактический адрес проживания"
                    },
                    "children": [
                      {
                        "model": "$model(residenceAddress.region)",
                        "component": "$component(Select)",
                        "componentProps": {
                          "label": "Регион",
                          "testId": "residenceAddress-region",
                          "options": "$dataSource(REGIONS)"
                        }
                      },
                      {
                        "model": "$model(residenceAddress.city)",
                        "component": "$component(Select)",
                        "componentProps": {
                          "label": "Город",
                          "testId": "residenceAddress-city",
                          "options": [],
                          "placeholder": "Выберите регион"
                        }
                      },
                      {
                        "model": "$model(residenceAddress.street)",
                        "component": "$component(Input)",
                        "componentProps": {
                          "label": "Улица",
                          "testId": "residenceAddress-street",
                          "placeholder": "Введите улицу"
                        }
                      },
                      {
                        "model": "$model(residenceAddress.house)",
                        "component": "$component(Input)",
                        "componentProps": {
                          "label": "Дом",
                          "testId": "residenceAddress-house",
                          "placeholder": "№"
                        }
                      },
                      {
                        "model": "$model(residenceAddress.apartment)",
                        "component": "$component(Input)",
                        "componentProps": {
                          "label": "Квартира",
                          "testId": "residenceAddress-apartment",
                          "placeholder": "№"
                        }
                      },
                      {
                        "model": "$model(residenceAddress.postalCode)",
                        "component": "$component(InputMask)",
                        "componentProps": {
                          "label": "Индекс",
                          "testId": "residenceAddress-postalCode",
                          "mask": "999999",
                          "placeholder": "000000"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "$component(Step)",
        "componentProps": {
          "title": "Работа",
          "icon": "💼"
        },
        "children": [
          {
            "component": "$component(Box)",
            "componentProps": {
              "className": "space-y-4"
            },
            "children": [
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Занятость"
                },
                "children": [
                  {
                    "model": "$model(employmentStatus)",
                    "component": "$component(RadioGroup)",
                    "componentProps": {
                      "label": "Статус занятости",
                      "testId": "employmentStatus",
                      "options": "$dataSource(EMPLOYMENT_STATUSES)"
                    }
                  }
                ]
              },
              {
                "selector": "employed-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Работа по найму"
                },
                "children": [
                  {
                    "model": "$model(companyName)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Название компании",
                      "testId": "companyName",
                      "placeholder": "Введите название"
                    }
                  },
                  {
                    "model": "$model(companyInn)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "ИНН компании",
                      "testId": "companyInn",
                      "mask": "9999999999",
                      "placeholder": "1234567890"
                    }
                  },
                  {
                    "model": "$model(companyPhone)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "Телефон компании",
                      "testId": "companyPhone",
                      "mask": "+7 (999) 999-99-99",
                      "placeholder": "+7 (___) ___-__-__"
                    }
                  },
                  {
                    "model": "$model(companyAddress)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Адрес компании",
                      "testId": "companyAddress",
                      "placeholder": "Полный адрес"
                    }
                  },
                  {
                    "model": "$model(position)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Должность",
                      "testId": "position",
                      "placeholder": "Ваша должность"
                    }
                  }
                ]
              },
              {
                "selector": "self-employed-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Индивидуальный предприниматель"
                },
                "children": [
                  {
                    "model": "$model(businessType)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Тип бизнеса",
                      "testId": "businessType",
                      "placeholder": "ИП, ООО и т.д."
                    }
                  },
                  {
                    "model": "$model(businessInn)",
                    "component": "$component(InputMask)",
                    "componentProps": {
                      "label": "ИНН ИП",
                      "testId": "businessInn",
                      "mask": "999999999999",
                      "placeholder": "123456789012"
                    }
                  },
                  {
                    "model": "$model(businessActivity)",
                    "component": "$component(Textarea)",
                    "componentProps": {
                      "label": "Вид деятельности",
                      "testId": "businessActivity",
                      "rows": 2,
                      "placeholder": "Опишите вид деятельности"
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Стаж и доход"
                },
                "children": [
                  {
                    "model": "$model(workExperienceTotal)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Общий стаж работы (месяцев)",
                      "testId": "workExperienceTotal",
                      "min": 0
                    }
                  },
                  {
                    "model": "$model(workExperienceCurrent)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Стаж на текущем месте (месяцев)",
                      "testId": "workExperienceCurrent",
                      "min": 0
                    }
                  },
                  {
                    "model": "$model(monthlyIncome)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Ежемесячный доход (₽)",
                      "testId": "monthlyIncome",
                      "min": 0
                    }
                  },
                  {
                    "model": "$model(additionalIncome)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Дополнительный доход (₽)",
                      "testId": "additionalIncome",
                      "min": 0
                    }
                  },
                  {
                    "model": "$model(additionalIncomeSource)",
                    "component": "$component(Input)",
                    "componentProps": {
                      "label": "Источник дополнительного дохода",
                      "testId": "additionalIncomeSource",
                      "placeholder": "Опишите источник"
                    }
                  },
                  {
                    "model": "$model(totalIncome)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Общий доход (₽)",
                      "testId": "totalIncome",
                      "disabled": true
                    }
                  },
                  {
                    "model": "$model(paymentToIncomeRatio)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Процент платежа от дохода (%)",
                      "testId": "paymentToIncomeRatio",
                      "disabled": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "component": "$component(Step)",
        "componentProps": {
          "title": "Дополнительно",
          "icon": "📋"
        },
        "children": [
          {
            "component": "$component(Box)",
            "componentProps": {
              "className": "space-y-4"
            },
            "children": [
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Личное"
                },
                "children": [
                  {
                    "model": "$model(maritalStatus)",
                    "component": "$component(RadioGroup)",
                    "componentProps": {
                      "label": "Семейное положение",
                      "testId": "maritalStatus",
                      "options": "$dataSource(MARITAL_STATUSES)"
                    }
                  },
                  {
                    "model": "$model(dependents)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "label": "Количество иждивенцев",
                      "testId": "dependents",
                      "min": 0,
                      "max": 10
                    }
                  },
                  {
                    "model": "$model(education)",
                    "component": "$component(Select)",
                    "componentProps": {
                      "label": "Образование",
                      "testId": "education",
                      "options": "$dataSource(EDUCATION_LEVELS)"
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Имущество"
                },
                "children": [
                  {
                    "model": "$model(hasProperty)",
                    "component": "$component(Checkbox)",
                    "componentProps": {
                      "label": "У меня есть имущество",
                      "testId": "hasProperty"
                    }
                  },
                  {
                    "selector": "properties-section",
                    "model": "$model(properties)",
                    "component": "$component(FormArray)",
                    "componentProps": {
                      "title": "Объекты имущества",
                      "addButtonLabel": "+ Добавить имущество",
                      "emptyMessage": "Нажмите «Добавить имущество», чтобы добавить запись",
                      "itemLabel": "$dataSource(PROPERTY_ITEM_LABEL)"
                    },
                    "item": {
                      "$template": {
                        "component": "$component(Box)",
                        "componentProps": {
                          "className": "space-y-3"
                        },
                        "children": [
                          {
                            "model": "$model(type)",
                            "component": "$component(Select)",
                            "componentProps": {
                              "label": "Тип имущества",
                              "testId": "type",
                              "options": "$dataSource(PROPERTY_TYPES)"
                            }
                          },
                          {
                            "model": "$model(description)",
                            "component": "$component(Textarea)",
                            "componentProps": {
                              "label": "Описание",
                              "testId": "description",
                              "rows": 2,
                              "placeholder": "Опишите имущество"
                            }
                          },
                          {
                            "model": "$model(estimatedValue)",
                            "component": "$component(InputNumber)",
                            "componentProps": {
                              "label": "Оценочная стоимость (₽)",
                              "testId": "estimatedValue",
                              "min": 0
                            }
                          },
                          {
                            "model": "$model(hasEncumbrance)",
                            "component": "$component(Checkbox)",
                            "componentProps": {
                              "label": "Имеется обременение (залог)",
                              "testId": "hasEncumbrance"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Действующие кредиты"
                },
                "children": [
                  {
                    "model": "$model(hasExistingLoans)",
                    "component": "$component(Checkbox)",
                    "componentProps": {
                      "label": "У меня есть другие кредиты",
