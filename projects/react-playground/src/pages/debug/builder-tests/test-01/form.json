{
  "$schema": "./form-schema.schema.json",
  "version": "1.0",
  "root": {
    "$nodeId": "8emzj8fz",
    "component": "$html(div)",
    "componentProps": {
      "className": "space-y-4"
    },
    "children": [
      {
        "$nodeId": "e2yf5n1v",
        "selector": "name",
        "value": "$model(name)",
        "component": "$component(Input)",
        "componentProps": {
          "label": "Имя"
        }
      },
      {
        "$nodeId": "p9ijt80t",
        "selector": "email",
        "value": "$model(email)",
        "component": "$component(Input)",
        "componentProps": {
          "label": "Email",
          "type": "email"
        }
      },
      {
        "$nodeId": "4cfxsohp",
        "component": "$component(TypographyP)",
        "componentProps": {
          "className": "space-y-4"
        },
        "children": ["$model(name)"]
      }
    ]
  }
}
