{
  "version": "1.0",
  "root": {
    "component": "$html(div)",
    "componentProps": { "className": "mx-auto max-w-xl space-y-4 p-6" },
    "children": [
      {
        "component": "$html(header)",
        "children": [
          {
            "component": "$html(h1)",
            "componentProps": { "className": "text-xl font-semibold text-gray-800" },
            "children": ["Список алертов из модели"]
          },
          {
            "component": "$html(p)",
            "componentProps": { "className": "text-sm text-gray-500" },
            "children": [
              "Массив alerts живёт в модели; behavior пересобирает его при изменении полей, а список рендерит $component(List) с $template на каждый элемент."
            ]
          }
        ]
      },
      {
        "value": "$model(amount)",
        "component": "$component(Input)",
        "componentProps": { "label": "Сумма кредита, ₽", "type": "number", "testId": "amount" }
      },
      {
        "value": "$model(email)",
        "component": "$component(Input)",
        "componentProps": { "label": "Email", "testId": "email" }
      },
      {
        "component": "$html(div)",
        "componentProps": { "className": "pt-2" },
        "children": [
          {
            "component": "$html(h2)",
            "componentProps": { "className": "mb-2 text-sm font-medium text-gray-500" },
            "children": ["Уведомления"]
          },
          {
            "selector": "alerts-list",
            "array": "$model(alerts)",
            "component": "$component(List)",
            "componentProps": { "className": "space-y-2", "testId": "alerts" },
            "item": {
              "$template": {
                "component": "$component(Alert)",
                "componentProps": { "type": "$model(type)", "message": "$model(message)" }
              }
            }
          }
        ]
      }
    ]
  }
}
