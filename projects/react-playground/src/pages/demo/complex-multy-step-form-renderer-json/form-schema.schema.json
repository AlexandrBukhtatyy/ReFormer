{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reformer.dev/schemas/credit-application.schema.json",
  "title": "Credit application form schema (format 2, generated)",
  "description": "GENERATED by react-playground/scripts/gen-form-json-schema.ts from createCreditApplicationRegistry — DO NOT EDIT BY HAND. Materialized snapshot of the base form-DSL meta-schema (@reformer/renderer-json) with componentOp tightened to the registry enum. Re-run `npm run gen:form-schema` after changing the registry.",
  "type": "object",
  "required": [
    "format",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 2,
      "description": "Document format. A document without this field is the previous format — convert it with migrateJsonSchema."
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Version of the form CONTENT (checked by the form registry). Unrelated to the document format."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "parts": {
      "type": "object",
      "description": "Named parts of the document: sub-forms and array row templates, referenced with \"$part(name)\". $model paths inside a part are relative to the sub-model it is attached to.",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    },
    "root": {
      "$ref": "#/definitions/node"
    }
  },
  "definitions": {
    "modelOp": {
      "type": "string",
      "pattern": "^\\$model\\(.+\\)$",
      "description": "Model binding: \"$model(path)\" — path resolved at runtime (not validated here)."
    },
    "componentOp": {
      "type": "string",
      "description": "Registry component: \"$component(Name)\". Name is tightened to a registry enum by buildFormSchemaMetaSchema.",
      "enum": [
        "$component(Input)",
        "$component(InputNumber)",
        "$component(InputPassword)",
        "$component(InputMask)",
        "$component(Textarea)",
        "$component(Select)",
        "$component(Checkbox)",
        "$component(RadioGroup)",
        "$component(FileUpload)",
        "$component(FileUploadDropzone)",
        "$component(Box)",
        "$component(Section)",
        "$component(FormArray)",
        "$component(Collapsible)",
        "$component(AsyncBoundary)",
        "$component(FormField)",
        "$component(Button)",
        "$component(FormWizard)",
        "$component(Step)",
        "$component(ResidenceAddressSection)",
        "$component(UnemployedWarning)",
        "$component(ConfirmationInfoBlock)",
        "$component(HighPaymentWarning)",
        "$component(LoanSummarySection)",
        "$component(ApplicantSummarySection)",
        "$component(SubmitWarning)",
        "$component(NextStepsInfo)",
        "$component(ElectronicSignatureHint)",
        "$component($fieldWrapper)"
      ]
    },
    "partOp": {
      "type": "string",
      "pattern": "^\\$part\\(.+\\)$",
      "description": "Named part of the document: \"$part(name)\" — a key of the root \"parts\" map (checked by validateFormSchema)."
    },
    "htmlOp": {
      "type": "string",
      "description": "Native HTML tag: \"$html(div)\". The tag is checked against the presentational whitelist (isAllowedHtmlTag) by validateFormSchema and by the converter; buildFormSchemaMetaSchema tightens it to an enum for IDE completion.",
      "enum": [
        "$html(div)",
        "$html(section)",
        "$html(article)",
        "$html(aside)",
        "$html(header)",
        "$html(footer)",
        "$html(nav)",
        "$html(main)",
        "$html(figure)",
        "$html(figcaption)",
        "$html(details)",
        "$html(summary)",
        "$html(fieldset)",
        "$html(legend)",
        "$html(p)",
        "$html(span)",
        "$html(h1)",
        "$html(h2)",
        "$html(h3)",
        "$html(h4)",
        "$html(h5)",
        "$html(h6)",
        "$html(strong)",
        "$html(b)",
        "$html(em)",
        "$html(i)",
        "$html(u)",
        "$html(s)",
        "$html(small)",
        "$html(mark)",
        "$html(sub)",
        "$html(sup)",
        "$html(code)",
        "$html(pre)",
        "$html(kbd)",
        "$html(samp)",
        "$html(var)",
        "$html(blockquote)",
        "$html(cite)",
        "$html(q)",
        "$html(abbr)",
        "$html(time)",
        "$html(address)",
        "$html(label)",
        "$html(br)",
        "$html(hr)",
        "$html(a)",
        "$html(ul)",
        "$html(ol)",
        "$html(li)",
        "$html(dl)",
        "$html(dt)",
        "$html(dd)",
        "$html(table)",
        "$html(caption)",
        "$html(colgroup)",
        "$html(col)",
        "$html(thead)",
        "$html(tbody)",
        "$html(tfoot)",
        "$html(tr)",
        "$html(th)",
        "$html(td)",
        "$html(img)",
        "$html(picture)",
        "$html(source)",
        "$html(video)",
        "$html(audio)",
        "$html(track)",
        "$html(progress)",
        "$html(meter)"
      ]
    },
    "textChild": {
      "description": "Text part of a node's children: a literal, or an operator string (\"$model(path)\" for reactive model values, \"$locale(key)\" for localized strings). Adjacent parts are joined without a separator.",
      "$comment": "Types are listed as separate anyOf branches rather than a union \"type\": [\"string\",\"number\"] — ajv's strict mode rejects union type keywords unless allowUnionTypes is on, and validateFormSchema compiles this schema without it.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "operatorOp": {
      "type": "string",
      "pattern": "^\\$(model|component|html|dataSource|fn|locale)\\(.+\\)$",
      "description": "Any DSL operator string (\"$model/$component/$dataSource/$fn/$locale(...)\") used as an escape hatch on a componentProps value (e.g. \"options\": \"$dataSource(LOAN_TYPES)\"). The component-props validator wraps every prop in anyOf:[honest type, operatorOp] via allowOperatorStrings, so an operator string is accepted wherever a literal value is."
    },
    "stepRef": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "additionalProperties": false,
      "properties": {
        "$ref": {
          "type": "string"
        }
      },
      "description": "A wizard step moved to its own file. Assemble the document with composeJsonFormSchema before rendering."
    },
    "node": {
      "$comment": "Discriminated by which keys are present (model+item → array, model+part → sub-form, model → field, otherwise container), mirroring the isArrayNode/isPartNode/isFieldNode/isContainerNode runtime guards. Using oneOf here made ajv (allErrors) report failures against every branch for any single mistake, burying the real cause; if/then/else surfaces only the relevant branch's errors.",
      "if": {
        "type": "object",
        "required": [
          "model",
          "item"
        ]
      },
      "then": {
        "$ref": "#/definitions/arrayNode"
      },
      "else": {
        "if": {
          "type": "object",
          "required": [
            "model",
            "part"
          ]
        },
        "then": {
          "$ref": "#/definitions/partNode"
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "model"
            ]
          },
          "then": {
            "$ref": "#/definitions/fieldNode"
          },
          "else": {
            "$ref": "#/definitions/containerNode"
          }
        }
      }
    },
    "fieldNode": {
      "type": "object",
      "required": [
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "$nodeId": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}$"
        },
        "selector": {
          "type": "string"
        },
        "model": {
          "$ref": "#/definitions/modelOp"
        },
        "component": {
          "$ref": "#/definitions/componentOp"
        },
        "componentProps": {
          "type": "object"
        },
        "wrapper": {
          "$ref": "#/definitions/node"
        }
      }
    },
    "arrayNode": {
      "type": "object",
      "required": [
        "model",
        "item"
      ],
      "additionalProperties": false,
      "properties": {
        "$nodeId": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}$"
        },
        "selector": {
          "type": "string"
        },
        "model": {
          "$ref": "#/definitions/modelOp"
        },
        "component": {
          "$ref": "#/definitions/componentOp"
        },
        "item": {
          "$comment": "A row template: an inline node ({ \"$template\": … }) or a named part (\"$part(name)\"). Dispatched with if/then/else for the same reason as \"node\".",
          "if": {
            "type": "string"
          },
          "then": {
            "$ref": "#/definitions/partOp"
          },
          "else": {
            "type": "object",
            "required": [
              "$template"
            ],
            "additionalProperties": false,
            "properties": {
              "$template": {
                "$ref": "#/definitions/node"
              }
            }
          }
        },
        "initialValue": {
          "type": "object",
          "description": "Fallback template of a new row. The template declared in the model (arrayOf) takes precedence."
        },
        "componentProps": {
          "type": "object"
        }
      }
    },
    "partNode": {
      "type": "object",
      "required": [
        "model",
        "part"
      ],
      "additionalProperties": false,
      "properties": {
        "$nodeId": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}$"
        },
        "selector": {
          "type": "string"
        },
        "model": {
          "$ref": "#/definitions/modelOp"
        },
        "part": {
          "$ref": "#/definitions/partOp"
        }
      }
    },
    "containerNode": {
      "type": "object",
      "required": [
        "component"
      ],
      "additionalProperties": false,
      "properties": {
        "$nodeId": {
          "type": "string",
          "pattern": "^[0-9a-z]{8}$"
        },
        "selector": {
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/definitions/componentOp"
            },
            {
              "$ref": "#/definitions/htmlOp"
            }
          ]
        },
        "componentProps": {
          "type": "object"
        },
        "children": {
          "$comment": "A child is a nested node (object), a wizard step reference ({ \"$ref\" }) or a text part (string/number). Dispatched with if/then/else rather than anyOf for the same reason as \"node\": with allErrors ajv would report failures from every branch, burying the real cause.",
          "type": "array",
          "items": {
            "if": {
              "type": "object"
            },
            "then": {
              "if": {
                "type": "object",
                "required": [
                  "$ref"
                ]
              },
              "then": {
                "$ref": "#/definitions/stepRef"
              },
              "else": {
                "$ref": "#/definitions/node"
              }
            },
            "else": {
              "$ref": "#/definitions/textChild"
            }
          }
        }
      }
    }
  }
}
