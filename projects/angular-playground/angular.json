{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-playground": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "@taiga-ui/styles/taiga-ui-theme.css",
              "@reformer/kit-taiga/styles.css",
              "src/styles.css",
              "src/cross/cross.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "bench-registration": {
              "browser": "src/bench/registration.ts",
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": true,
                "hidden": true
              },
              "statsJson": true
            },
            "bench-credit": {
              "browser": "src/bench/credit.ts",
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": true,
                "hidden": true
              },
              "statsJson": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-playground:build:production"
            },
            "development": {
              "buildTarget": "angular-playground:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
