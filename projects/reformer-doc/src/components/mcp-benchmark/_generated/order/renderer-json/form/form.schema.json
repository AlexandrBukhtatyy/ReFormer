{
  "format": 2,
  "meta": {
    "description": "@reformer-form-build 42c0badbbfd0cb74 собран сервером ReFormer из form.intent.json: форму меняют через сервер (form_build; в guided — form_start, затем form_edit), а не этот файл — правка руками отсоединит его от сборки, guided её отменит"
  },
  "parts": {
    "itemsRow": {
      "component": "$html(div)",
      "children": [
        {
          "selector": "title",
          "model": "$model(title)",
          "component": "$component(Input)",
          "componentProps": {
            "label": "Наименование",
            "testId": "items-title"
          }
        },
        {
          "selector": "quantity",
          "model": "$model(quantity)",
          "component": "$component(InputNumber)",
          "componentProps": {
            "label": "Количество",
            "testId": "items-quantity"
          }
        },
        {
          "selector": "price",
          "model": "$model(price)",
          "component": "$component(InputNumber)",
          "componentProps": {
            "label": "Цена",
            "testId": "items-price"
          }
        },
        {
          "selector": "lineTotal",
          "model": "$model(lineTotal)",
          "component": "$component(InputNumber)",
          "componentProps": {
            "readOnly": true,
            "label": "Сумма",
            "testId": "items-lineTotal"
          }
        }
      ]
    },
    "recipientsRow": {
      "component": "$html(div)",
      "children": [
        {
          "selector": "email",
          "model": "$model(email)",
          "component": "$component(Input)",
          "componentProps": {
            "label": "Email получателя",
            "testId": "recipients-email"
          }
        },
        {
          "selector": "primary",
          "model": "$model(primary)",
          "component": "$component(Checkbox)",
          "componentProps": {
            "label": "Основной получатель",
            "testId": "recipients-primary"
          }
        }
      ]
    }
  },
  "root": {
    "component": "$component(Box)",
    "children": [
      {
        "selector": "pokupatel",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Покупатель"
        },
        "children": [
          {
            "selector": "customerType",
            "model": "$model(customerType)",
            "component": "$component(Select)",
            "componentProps": {
              "options": [
                {
                  "value": "person",
                  "label": "Физическое лицо"
                },
                {
                  "value": "company",
                  "label": "Юридическое лицо"
                }
              ],
              "label": "Тип покупателя",
              "testId": "customerType"
            }
          },
          {
            "selector": "contact.lastName",
            "model": "$model(contact.lastName)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Фамилия",
              "testId": "contact-lastName"
            }
          },
          {
            "selector": "contact.firstName",
            "model": "$model(contact.firstName)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Имя",
              "testId": "contact-firstName"
            }
          },
          {
            "selector": "email",
            "model": "$model(email)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Email",
              "testId": "email"
            }
          },
          {
            "selector": "phone",
            "model": "$model(phone)",
            "component": "$component(InputMask)",
            "componentProps": {
              "label": "Телефон",
              "testId": "phone"
            }
          },
          {
            "selector": "birthDate",
            "model": "$model(birthDate)",
            "component": "$component(Input)",
            "componentProps": {
              "type": "date",
              "label": "Дата рождения",
              "testId": "birthDate"
            }
          }
        ]
      },
      {
        "selector": "company",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Компания"
        },
        "children": [
          {
            "selector": "company.name",
            "model": "$model(company.name)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Название организации",
              "testId": "company-name"
            }
          },
          {
            "selector": "company.inn",
            "model": "$model(company.inn)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "ИНН",
              "testId": "company-inn"
            }
          }
        ]
      },
      {
        "selector": "dostavka",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Доставка"
        },
        "children": [
          {
            "selector": "deliveryMethod",
            "model": "$model(deliveryMethod)",
            "component": "$component(Select)",
            "componentProps": {
              "options": [
                {
                  "value": "pickup",
                  "label": "Самовывоз"
                },
                {
                  "value": "courier",
                  "label": "Курьер"
                },
                {
                  "value": "post",
                  "label": "Почта"
                }
              ],
              "label": "Способ получения",
              "testId": "deliveryMethod"
            }
          },
          {
            "selector": "deliveryAddress.city",
            "model": "$model(deliveryAddress.city)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Город",
              "testId": "deliveryAddress-city"
            }
          },
          {
            "selector": "deliveryAddress.street",
            "model": "$model(deliveryAddress.street)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Улица",
              "testId": "deliveryAddress-street"
            }
          },
          {
            "selector": "deliveryAddress.house",
            "model": "$model(deliveryAddress.house)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Дом",
              "testId": "deliveryAddress-house"
            }
          },
          {
            "selector": "deliveryDate",
            "model": "$model(deliveryDate)",
            "component": "$component(DatePicker)",
            "componentProps": {
              "label": "Дата доставки",
              "testId": "deliveryDate"
            }
          },
          {
            "selector": "billingSame",
            "model": "$model(billingSame)",
            "component": "$component(Checkbox)",
            "componentProps": {
              "label": "Адрес для счёта совпадает с адресом доставки",
              "testId": "billingSame"
            }
          },
          {
            "selector": "billingAddress.city",
            "model": "$model(billingAddress.city)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Город",
              "testId": "billingAddress-city"
            }
          },
          {
            "selector": "billingAddress.street",
            "model": "$model(billingAddress.street)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Улица",
              "testId": "billingAddress-street"
            }
          },
          {
            "selector": "billingAddress.house",
            "model": "$model(billingAddress.house)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Дом",
              "testId": "billingAddress-house"
            }
          }
        ]
      },
      {
        "selector": "tovary",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Товары"
        },
        "children": [
          {
            "selector": "items",
            "model": "$model(items)",
            "component": "$component(FieldArray)",
            "componentProps": {
              "title": "Товары",
              "minItems": 1,
              "maxItems": 10
            },
            "item": "$part(itemsRow)"
          },
          {
            "selector": "subtotal",
            "model": "$model(subtotal)",
            "disabled": true,
            "component": "$component(InputNumber)",
            "componentProps": {
              "readOnly": true,
              "label": "Сумма товаров",
              "testId": "subtotal"
            }
          }
        ]
      },
      {
        "selector": "oplata",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Оплата"
        },
        "children": [
          {
            "selector": "promoCode",
            "model": "$model(promoCode)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Промокод",
              "testId": "promoCode"
            }
          },
          {
            "selector": "discount",
            "model": "$model(discount)",
            "component": "$component(Slider)",
            "componentProps": {
              "label": "Скидка, %",
              "testId": "discount"
            }
          },
          {
            "selector": "total",
            "model": "$model(total)",
            "disabled": true,
            "component": "$component(InputNumber)",
            "componentProps": {
              "readOnly": true,
              "label": "Итого",
              "testId": "total"
            }
          },
          {
            "selector": "paymentMethod",
            "model": "$model(paymentMethod)",
            "component": "$component(Select)",
            "componentProps": {
              "options": [
                {
                  "value": "card",
                  "label": "Картой онлайн"
                },
                {
                  "value": "cash",
                  "label": "При получении"
                },
                {
                  "value": "invoice",
                  "label": "По счёту"
                }
              ],
              "label": "Способ оплаты",
              "testId": "paymentMethod"
            }
          },
          {
            "selector": "receiptEmail",
            "model": "$model(receiptEmail)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Email для чека",
              "testId": "receiptEmail"
            }
          },
          {
            "selector": "comment",
            "model": "$model(comment)",
            "component": "$component(Textarea)",
            "componentProps": {
              "label": "Комментарий к заказу",
              "testId": "comment"
            }
          }
        ]
      },
      {
        "selector": "podtverzhdenie",
        "component": "$component(Section)",
        "componentProps": {
          "title": "Подтверждение"
        },
        "children": [
          {
            "selector": "recipients",
            "model": "$model(recipients)",
            "component": "$component(FieldArray)",
            "componentProps": {
              "title": "Кому отправлять уведомления",
              "minItems": 1
            },
            "item": "$part(recipientsRow)"
          },
          {
            "selector": "agreeTerms",
            "model": "$model(agreeTerms)",
            "component": "$component(Checkbox)",
            "componentProps": {
              "label": "Согласен с условиями оферты",
              "testId": "agreeTerms"
            }
          },
          {
            "selector": "newsletter",
            "model": "$model(newsletter)",
            "component": "$component(Switch)",
            "componentProps": {
              "label": "Получать новости и акции",
              "testId": "newsletter"
            }
          },
          {
            "selector": "sources",
            "model": "$model(sources)",
            "component": "$component(Select)",
            "componentProps": {
              "options": [
                {
                  "value": "search",
                  "label": "Поиск"
                },
                {
                  "value": "friends",
                  "label": "Друзья"
                },
                {
                  "value": "ads",
                  "label": "Реклама"
                },
                {
                  "value": "other",
                  "label": "Другое"
                }
              ],
              "label": "Как вы о нас узнали",
              "testId": "sources"
            }
          }
        ]
      },
      {
        "selector": "submit",
        "component": "$component(Button)",
        "componentProps": {
          "type": "button"
        },
        "children": [
          "Оформить заказ"
        ]
      }
    ]
  }
}
