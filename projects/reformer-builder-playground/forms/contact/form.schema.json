{
  "$schema": "./form-schema.schema.json",
  "version": "1.0",
  "root": {
    "$nodeId": "demoroot",
    "component": "$html(div)",
    "componentProps": {
      "className": "space-y-4"
    },
    "children": [
      {
        "$nodeId": "2fvbboa1",
        "component": "$html(div)",
        "componentProps": {
          "className": "flex gap-4"
        },
        "children": [
          {
            "$nodeId": "demoname",
            "selector": "name",
            "value": "$model(name)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Имя",
              "placeholder": "Как к вам обращаться"
            }
          },
          {
            "$nodeId": "demomail",
            "selector": "email",
            "value": "$model(email)",
            "component": "$component(Input)",
            "componentProps": {
              "label": "Email"
            }
          }
        ]
      },
      {
        "$nodeId": "ggjp5tr9",
        "value": "$model(newField)",
        "component": "$component(Checkbox)",
        "componentProps": {
          "label": "Checkbox"
        }
      },
      {
        "$nodeId": "demochan",
        "selector": "channel",
        "value": "$model(channel)",
        "component": "$component(Select)",
        "componentProps": {
          "label": "Как связаться",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Телефон"
            }
          ]
        }
      },
      {
        "$nodeId": "demoagre",
        "selector": "agree",
        "value": "$model(agree)",
        "component": "$component(Checkbox)",
        "componentProps": {
          "label": "Согласен на обработку данных"
        }
      },
      {
        "$nodeId": "um6zmmom",
        "value": "$model(newField)",
        "component": "$component(Select)",
        "componentProps": {
          "label": "Select"
        }
      },
      {
        "$nodeId": "lse4h9pg",
        "value": "$model(newField)",
        "component": "$component(Slider)",
        "componentProps": {
          "label": "Slider"
        }
      }
    ]
  }
}
