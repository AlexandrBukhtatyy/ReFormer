{
  "name": "@reformer/builder-base-markdown-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Плагин ReFormer Builder «Markdown»: предпросмотр markdown-файлов — рендер, режим «рядом», подсветка кода и переход по ссылкам проекта",
  "scripts": {
    "generate:styles": "node ../../.shared/plugin-styles.mjs --plugin @tailwindcss/typography --include src/highlight.css",
    "prevalidate": "npm run generate:styles",
    "validate": "reformer-plugin validate src",
    "prebuild:dev": "npm run generate:styles",
    "prebuild:dist": "npm run generate:styles",
    "predev": "npm run generate:styles",
    "build:dev": "reformer-plugin build src --out .",
    "build:dist": "reformer-plugin build src --out dist --minify",
    "dev": "reformer-plugin dev src --out .",
    "test": "node ../../../../../../scripts/run-vitest.mjs",
    "test:browser": "node ../../../../../../scripts/run-vitest.mjs -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-plugin-cli": "*",
    "@reformer/ui-kit": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
