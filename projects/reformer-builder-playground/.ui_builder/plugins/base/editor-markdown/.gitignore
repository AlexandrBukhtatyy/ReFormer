# Сборка для билдера — `npm run build:dev`: он грузит плагин из корня этого каталога.
# Исходники — в src/, сборка для поставки (`npm run build:dist`) — в dist/.
/manifest.json
/main.js
/styles.css
/locales/

# Таблица стилей плагина — её собирает `npm run generate:styles`: типографика предпросмотра,
# недостающие утилиты Tailwind и палитра подсветки (см. `.shared/plugin-styles.mjs`).
/src/styles.css
