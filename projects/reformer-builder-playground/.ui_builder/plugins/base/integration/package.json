{
  "name": "@reformer/builder-base-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Интеграционные тесты домена base: его плагины вместе с настоящей оболочкой ReFormer Builder. Не плагин",
  "scripts": {
    "test": "node ../../../../../../scripts/run-vitest.mjs",
