{
  "name": "@reformer/builder-base-monaco-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Плагин ReFormer Builder «Редактор кода»: Monaco — подсветка, подсказки по схеме, разметка по находкам; движок едет внутри плагина отложенным модулем",
  "scripts": {
    "generate:styles": "node ../../.shared/plugin-styles.mjs",
    "prevalidate": "npm run generate:styles",
    "validate": "reformer-plugin validate src",
    "prebuild:dev": "npm run generate:styles",
    "prebuild:dist": "npm run generate:styles",
    "predev": "npm run generate:styles",
    "build:dev": "reformer-plugin build src --out . --bundle-css",
    "build:dist": "reformer-plugin build src --out dist --bundle-css --minify",
    "dev": "reformer-plugin dev src --out . --bundle-css",
    "test": "node ../../../../../../scripts/run-vitest.mjs",
    "test:browser": "node ../../../../../../scripts/run-vitest.mjs -c vitest.browser.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-plugin-cli": "*",
    "@reformer/ui-kit": "*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
