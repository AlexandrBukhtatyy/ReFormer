{
  "name": "@reformer/builder-forms-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Плагин ReFormer Builder «Предпросмотр»: превью-хост — выбор поверхности превью, состояние по документу и находки сборки формы",
  "scripts": {
    "validate": "reformer-plugin validate src",
    "build:dev": "reformer-plugin build src --out .",
    "build:dist": "reformer-plugin build src --out dist --minify",
    "dev": "reformer-plugin dev src --out .",
    "test": "node ../../../../../../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-plugin-cli": "*",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
