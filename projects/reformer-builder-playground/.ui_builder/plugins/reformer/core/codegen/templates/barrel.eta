// <%= it.layout.files.barrel %> — публичные экспорты модуля формы: страница, сборка, запись реестра форм, тип.
// Регенерируется билдером; правки будут перезаписаны.

export { default } from '<%= it.rel('barrel', 'page') %>';
<%~ it.imports([it.names.formFactory, 'createFormBehavior', 'formSchema'], it.rel('barrel', 'create'), 'export') %>
export { <%= it.names.entryConst %> } from '<%= it.rel('barrel', 'entry') %>';
export type { <%= it.names.TypeName %> } from '<%= it.rel('barrel', 'types') %>';
