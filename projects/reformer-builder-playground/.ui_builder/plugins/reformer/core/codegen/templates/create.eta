<%
const T = it.names.TypeName;
const overrides = `type Overrides = Pick<CreateFormConfig<${T}>, 'model' | 'schema' | 'registry'>;`;
-%>
// <%= it.layout.files.create %> — сборка формы: одна на все места подключения (страница, реестр
// форм, тесты). Регенерируется билдером; правки будут перезаписаны.

import { createForm, type CreateFormConfig, type FormBundle } from '@reformer/core';
import { defineFormBehavior, type FormBehavior } from '@reformer/core/behaviors';
<% if (it.layout.isSplit) { -%>
<%~ it.imports(['composeJsonFormSchema', 'type JsonFormSchema', 'type JsonFormStep'], '@reformer/renderer-json') %>
<% } else { -%>
import type { JsonFormSchema } from '@reformer/renderer-json';
<% } -%>
import { behaviorRules } from '<%= it.rel('create', 'behavior') %>';
<% if (it.layout.isWizard) { -%>
import { formFlow } from '<%= it.rel('create', 'flow') %>';
<% } -%>
import { <%= it.names.modelFactory %> } from '<%= it.rel('create', 'model') %>';
import rawSchema from '<%= it.rel('create', 'schema') %>';
<% for (const step of it.layout.splitSteps) { -%>
import <%= step.schemaAlias %> from '<%= step.schemaImport %>';
<% } -%>
import { createRegistry } from '<%= it.rel('create', 'registry') %>';
import type { <%= T %> } from '<%= it.rel('create', 'types') %>';
import { formValidation } from '<%= it.rel('create', 'validation') %>';
import { wireSubmit, type SubmitOptions } from '<%= it.rel('create', 'submit') %>';

<% if (it.layout.isSplit) { -%>
// Шаги визарда лежат в своих файлах: корневой документ держит ссылки (`$ref`), а форма
// собирается здесь. Ключ — ссылка как она записана в корневом документе.
const stepSchemas: Record<string, JsonFormStep> = {
<% for (const step of it.layout.splitSteps) { -%>
  '<%= step.schemaRef %>': <%= step.schemaAlias %> as unknown as JsonFormStep,
<% } -%>
};

// В чистом JSON операторы типизируются как `string` — приведение к схеме модели формы.
export const formSchema = composeJsonFormSchema(
  rawSchema as unknown as JsonFormSchema,
  stepSchemas
) as unknown as JsonFormSchema<<%= T %>>;
<% } else { -%>
// В чистом JSON операторы типизируются как `string` — приведение к схеме модели формы.
<%~ it.format(`export const formSchema = rawSchema as unknown as JsonFormSchema<${T}>;`) %>
<% } -%>

/** Поведение сборки: правила формы и отправка. Фабрика — настройки приходят от места подключения. */
<%~ it.signature('export function createFormBehavior', ['options: SubmitOptions = {}'], `: FormBehavior<${T}> {`) %>
  return defineFormBehavior<<%= T %>>((scope) => {
    behaviorRules(scope);
    wireSubmit(scope, options);
  });
}

<% if (it.fits(overrides)) { -%>
<%~ overrides %>
<% } else { -%>
type Overrides = Pick<
  CreateFormConfig<<%= T %>>,
  'model' | 'schema' | 'registry'
>;
<% } -%>

/** Сборка формы — одна на все места подключения. */
<%~ it.signature(`export function ${it.names.formFactory}`, ['options: SubmitOptions = {}', 'overrides: Overrides = {}'], `: FormBundle<${T}> {`) %>
  return createForm<<%= T %>>({
    model: <%= it.names.modelFactory %>(),
    schema: formSchema,
    registry: createRegistry(),
    behavior: createFormBehavior(options),
    validation: formValidation,
<% if (it.layout.isWizard) { -%>
    flow: formFlow,
<% } -%>
    ...overrides,
  });
}
