<% const T = it.names.TypeName; -%>
// <%= it.layout.files.api %> — запросы к серверу: отправка формы. Заготовка: реализуйте реальные
// запросы. Ваш файл: пишется один раз и при регенерации не затирается.

import type { <%= T %> } from '<%= it.rel('api', 'types') %>';

export type ApiResult<T> = { success: true; data: T } | { success: false; error: string };

const API_DELAY = 600;

function wait(ms: number): Promise<void> {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

/** POST — отправка формы. TODO: заменить на реальный запрос. */
<%~ it.signature('export async function submitForm', [`values: ${T}`], ': Promise<ApiResult<{ id: string }>> {') %>
  await wait(API_DELAY);
  console.info('[<%= it.names.dir %>] submit', values);
  return { success: true, data: { id: String(Date.now()) } };
}
