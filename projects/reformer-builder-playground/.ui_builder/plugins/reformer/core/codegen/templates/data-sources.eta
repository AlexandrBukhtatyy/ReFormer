// <%= it.layout.files.constants %> — опции и константы источников данных ($dataSource).
// МОК: значения синтезированы, замените реальными. Ваш файл: пишется один раз и при
// регенерации не затирается.

<% if (it.dataSources.isEmpty) { -%>
// Источников данных в схеме нет. Появятся — их значения объявляются здесь.
export {};
<% } else { -%>
<% if (it.dataSources.options.length > 0) { -%>
import type { SelectOption } from '<%= it.rel('constants', 'types') %>';

<% } -%>
<%~ it.blocks([
  it.dataSources.options
    .map((d) => `export const ${d.name}: SelectOption[] = ${it.json(d.value)};`)
    .join('\n\n'),
  it.dataSources.scalars.map((d) => `export const ${d.name} = ${d.literal};`).join('\n'),
  it.dataSources.labels
    .map((name) => `export const ${name} = (_item: unknown, index: number): string =>\n  '#' + (index + 1); // TODO: подпись элемента`)
    .join('\n'),
]) %>
<% } -%>
