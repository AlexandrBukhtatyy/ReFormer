<%
const T = it.names.TypeName;
const head = `export const ${it.names.entryConst}: FormEntry<${T}>`;
// Объявление, не поместившееся в строку, форматтер переносит после `=` и сдвигает объект.
const wide = !it.fits(`${head} = {`);
const p = wide ? '    ' : '  ';
-%>
// <%= it.layout.files.entry %> — запись формы в реестре форм (`@reformer/form-registry`).
// Регенерируется билдером; правки будут перезаписаны.

import type { FormEntry } from '@reformer/form-registry';
<% if (it.layout.isWizard) { -%>
import { formFlow } from '<%= it.rel('entry', 'flow') %>';
<% } -%>
import { <%= it.names.modelFactory %> } from '<%= it.rel('entry', 'model') %>';
import { createRegistry } from '<%= it.rel('entry', 'registry') %>';
import type { <%= T %> } from '<%= it.rel('entry', 'types') %>';
import { formValidation } from '<%= it.rel('entry', 'validation') %>';
import { createFormBehavior, formSchema } from '<%= it.rel('entry', 'create') %>';
import type { SubmitOptions } from '<%= it.rel('entry', 'submit') %>';

/**
 * Запись формы «<%= it.names.title %>» в реестре форм.
 *
 * Регистрация в приложении — одна строка:
 * ```ts
 * import { getFormRegistry } from '@reformer/form-registry';
 * import { <%= it.names.entryConst %> } from './pages/demo/<%= it.names.dir %>';
 *
 * getFormRegistry().register(<%= it.names.entryConst %>);
 * ```
 *
 * После этого форма монтируется где угодно: `<FormOutlet id="<%= it.names.exampleId %>" />`, либо через
 * слот или маршрут, если заполнить `placement`.
 */
<% if (wide) { -%>
<%~ head %> =
  {
<% } else { -%>
<%~ head %> = {
<% } -%>
<%= p %>id: '<%= it.names.exampleId %>',
<%= p %>version: '1.0.0',
<%= p %>// Кто зарегистрировал: по этому полю различаются одинаковые id из разных микрофронтов.
<%= p %>owner: 'app', // TODO: имя вашего приложения-хоста

<%= p %>// Данные — единственная часть, которую можно доставить по сети.
<%= p %>schema: { kind: 'inline', value: formSchema },

<%= p %>// Код — только из бандла.
<%= p %>registry: { kind: 'inline', value: createRegistry() },
<%= p %>model: { kind: 'inline', value: <%= it.names.modelFactory %> },
<%= p %>// Фабрика: настройки места монтирования (`onResult`) хост передаёт пропом `behaviorOptions`.
<%= p %>behavior: { kind: 'inline', value: (options) => createFormBehavior(options as SubmitOptions) },
<%= p %>validation: { kind: 'inline', value: formValidation },
<% if (it.layout.isWizard) { -%>
<%= p %>flow: { kind: 'inline', value: formFlow },
<% } -%>

<%= p %>// Где показывать. Пусто — форма доступна только по id; заполните, чтобы показывать её
<%= p %>// в слоте хоста или на маршруте.
<%= p %>placement: { slots: [], routes: ['<%= it.names.routePath %>'] },

<%= p %>meta: {
<%= p %>  name: '<%= it.names.title %>',
<%= p %>  tags: ['renderer-json', 'form-registry'],
<%= p %>},
<%= wide ? '  ' : '' %>};
