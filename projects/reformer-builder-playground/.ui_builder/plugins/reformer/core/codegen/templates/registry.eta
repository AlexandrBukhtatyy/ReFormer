// <%= it.layout.files.registry %> — реестр компонентов и источников данных схемы. Регенерируется.

<% if (it.registry.hasPlaceholder) { -%>
import type { ReactNode } from 'react';
<% } -%>
import { <%= it.registry.kitSymbols.join(', ') %> } from '<%= it.kit.importSpecifier %>';
<% for (const extra of it.registry.extraImports) { -%>
import { <%= extra.symbols.join(', ') %> } from '<%= extra.from %>';
<% } -%>
import { defineRegistry, FIELD_WRAPPER, type ComponentRegistry } from '@reformer/renderer-json';
<% if (it.registry.dataSourceNames.length > 0) { -%>
import { <%= it.registry.dataSourceNames.join(', ') %> } from '<%= it.rel('registry', 'constants') %>';
<% } -%>
<% if (it.registry.hasPlaceholder) { -%>

/** Заглушка для компонента без прямого соответствия в ките (замените реальным). */
const Placeholder = ({ children }: { children?: ReactNode }): ReactNode => children ?? null;
<% } -%>

export function createRegistry(): ComponentRegistry {
  return defineRegistry((reg) => {
    reg.component(FIELD_WRAPPER, <%= it.registry.fieldWrapper %>);
<% if (it.registry.wizard !== null) { -%>
    // Визард — библиотечный: шаги берёт из узлов-детей, форму и поток — из сборки.
<% for (const name of it.registry.wizard.hostNames) { -%>
    reg.component('<%= name %>', <%= it.registry.wizard.symbol %>);
<% } -%>
<% if (it.registry.wizard.stepName !== null) { -%>
    reg.component('<%= it.registry.wizard.stepName %>', <%= it.registry.wizard.stepName %>);
<% } -%>
<% } -%>
<% for (const c of it.registry.components) { -%>
<% if (c.placeholder) { -%>
    reg.component('<%= c.name %>', Placeholder); // TODO: <%= c.reason %>
<% } else { -%>
    reg.component('<%= c.name %>', <%= c.symbol %>);
<% } -%>
<% } -%>
<% if (it.registry.dataSourceNames.length > 0) { %>
<% for (const name of it.registry.dataSourceNames) { -%>
    reg.dataSource('<%= name %>', <%= name %>);
<% } -%>
<% } -%>
  });
}
