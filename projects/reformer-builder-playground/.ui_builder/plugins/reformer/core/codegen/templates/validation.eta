<% if (it.rules.validationCode !== null) { -%>
<%~ it.rules.validationCode -%>
<% } else if (it.stepValidation !== null) { -%>
<% const sv = it.stepValidation; -%>
// form.validation.ts — валидация модели визарда. Правила шагов — в steps/<шаг>/form.validation.ts,
// здесь их сборка и поля вне шагов. Пишется один раз и при регенерации не затирается.

import { type FormModel } from '@reformer/core';
<% if (sv.rest.length > 0) { -%>
import {
  apply,
  applyValidationResult,
  validate,
  defineValidation,
  runValidation,
  type ValidationResult,
} from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
<% } else { -%>
import {
  apply,
  applyValidationResult,
  defineValidation,
  runValidation,
  type ValidationResult,
} from '@reformer/core/validation';
<% } -%>
import { stepValidations } from '<%= it.layout.imports.steps %>';
import type { <%= it.names.TypeName %> } from '<%= it.layout.imports.types %>';

type Root = <%= it.names.TypeName %>;

/** Полная проверка (отправка): правила всех шагов<%= sv.rest.length > 0 ? ' и поля вне шагов' : '' %>. */
<% if (sv.rest.length > 0) { -%>
export const formValidation = defineValidation<Root>(({ model }) => {
  apply(...stepValidations);
<% for (const path of sv.rest) { -%>
  validate(model.$.<%= path %>, [required()]);
<% } -%>
});
<% } else { -%>
export const formValidation = defineValidation<Root>(() => {
  apply(...stepValidations);
});
<% } -%>

/** Шаг без правил: проверка ничего не находит. */
const noStepRules = defineValidation<Root>(() => {});

/**
 * Проверка шага визарда (номер с единицы) — из неё визард строит поток шагов. `touch: true`
 * обязателен: киты показывают ошибку только у тронутого поля, и без него остановленный шаг
 * выглядел бы как неработающая кнопка.
 */
export function makeStepCheck(model: FormModel<Root>) {
  return async (step: number): Promise<ValidationResult> => {
    const result = await runValidation(model, stepValidations[step - 1] ?? noStepRules);
    applyValidationResult(result, { touch: true });
    return result;
  };
}
<% } else { -%>
// form.validation.ts — валидация модели. МОК: required выведены из схемы, допишите правила.
// Пишется один раз и при регенерации не затирается.

import { type FormModel } from '@reformer/core';
<% if (it.required.length > 0) { -%>
import {
  applyValidationResult,
  validate,
  defineValidation,
  runValidation,
  type ValidationResult,
} from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
<% } else { -%>
import {
  applyValidationResult,
  defineValidation,
  runValidation,
  type ValidationResult,
} from '@reformer/core/validation';
<% } -%>
import type { <%= it.names.TypeName %> } from '<%= it.layout.imports.types %>';

type Root = <%= it.names.TypeName %>;

<% if (it.required.length > 0) { -%>
export const formValidation = defineValidation<Root>(({ model }) => {
<% for (const path of it.required) { -%>
    validate(model.$.<%= path %>, [required()]);
<% } -%>
  });
<% } else { -%>
export const formValidation = defineValidation<Root>(() => {
    // TODO: правила валидации
  });
<% } -%>

/** Проверка шага визарда: правила шагам не разложены — каждый шаг проверяет всю форму. */
export function makeStepCheck(model: FormModel<Root>) {
  return async (_step: number): Promise<ValidationResult> => {
    const result = await runValidation(model, formValidation);
    applyValidationResult(result);
    return result;
  };
}
<% } -%>
