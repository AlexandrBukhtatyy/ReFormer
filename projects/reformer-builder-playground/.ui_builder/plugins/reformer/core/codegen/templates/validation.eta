<% const T = it.names.TypeName; -%>
<% const v = it.rules.validation; -%>
// <%= it.layout.files.validation %> — валидация формы: поле `validation` сборки (<%= it.layout.files.create %>).
<% if (it.layout.isWizard) { -%>
// Правила шагов — в validation/<шаг>.ts (их проверяет «Далее»); здесь — только правила вне шагов.
<% } -%>
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

import type { FormValidation } from '@reformer/core';
<% if (v.block !== null) { -%>
<%~ v.block.imports.join('\n') %>
<% } -%>
import type { <%= T %> } from '<%= it.rel('validation', 'types') %>';

<% if (v.block !== null) { -%>
<% if (it.layout.isWizard) { -%>
/** Правила вне шагов: проверяются целиком, при отправке. */
<% } else { -%>
/** Правила формы: проверяются при отправке. */
<% } -%>
export const <%= v.rulesName %> = defineValidation<<%= T %>>((<%= v.block.usesModel ? '{ model }' : '' %>) => {
<% if (v.block.body.length > 0) { -%>
<%~ it.indent(v.block.body, 2) %>
<% } else { -%>
  // TODO: правила формы
<% } -%>
});

/** Валидация формы — поле `validation` сборки. Сюда же — стратегия живой проверки (`strategy`). */
export const formValidation: FormValidation<<%= T %>> = { <%= v.field %>: <%= v.rulesName %> };
<% } else { -%>
/**
 * Валидация формы — поле `validation` сборки. Правил вне шагов нет: полный набор сборка собирает
 * из правил шагов потока. Появятся — объявите их здесь и передайте полем `extras`; сюда же —
 * стратегия живой проверки (`strategy`).
 */
export const formValidation: FormValidation<<%= T %>> = {};
<% } -%>
