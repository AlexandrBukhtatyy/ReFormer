<%
const T = it.names.TypeName;
const b = it.rules.behavior;
const body = [];
if (b.links.length > 0) body.push(['// Связи над моделью', ...b.links]);
for (const group of b.groups) {
  const lines = [group.step === null ? '// Правила узлов схемы' : `// Шаг «${group.step.title}»`];
  for (const rule of group.rules) lines.push(...rule.lines);
  if (group.scaffold.length > 0) {
    lines.push('// Условная видимость секций — раскомментируйте и впишите условие:');
    for (const section of group.scaffold) {
      lines.push(`// hideWhen(schema.node('${section.selector}'), () => /* TODO: условие для «${section.label}» */ false);`);
    }
  }
  body.push(lines);
}
-%>
// <%= it.layout.files.behavior %> — поведение формы: связи над моделью и правила узлов схемы.
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

import { <%= b.imports.join(', ') %>, type BehaviorScope } from '@reformer/core/behaviors';
import type { <%= T %> } from '<%= it.rel('behavior', 'types') %>';

/** Правила поведения формы. Функцией — чтобы сборка добавила к ним отправку (<%= it.layout.files.create %>). */
export function behaviorRules(<%= b.scope.length > 0 ? `{ ${b.scope.join(', ')} }` : '_scope' %>: BehaviorScope<<%= T %>>): void {
<% if (body.length > 0) { -%>
<%~ it.blocks(body.map((lines) => it.indent(lines, 2))) %>
<% } else { -%>
  // Правил пока нет — см. пример ниже.
<% } -%>
}

export const formBehavior = defineFormBehavior<<%= T %>>(behaviorRules);
<% if (!b.hasCode) { -%>

// --- ПРИМЕР ↓ замените функцию выше на такую и оставьте нужные строки ------------------
