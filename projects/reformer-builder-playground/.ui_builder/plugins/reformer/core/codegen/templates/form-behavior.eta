<%
const T = it.names.TypeName;
const b = it.rules.behavior;
const scaffoldLines = (sections) =>
  sections.length === 0
    ? []
    : [
        '// Условная видимость секций — раскомментируйте и впишите условие:',
        ...sections.map(
          (section) =>
            `// hideWhen(schema.node('${section.selector}'), () => /* TODO: условие для «${section.label}» */ false);`
        ),
      ];
const body = [];
if (b.links.length > 0) body.push(['// Связи над моделью', ...b.links]);
for (const group of b.groups) {
  const lines = [group.step === null ? '// Правила узлов схемы' : `// Шаг «${group.step.title}»`];
  for (const rule of group.rules) lines.push(...rule.lines);
  lines.push(...scaffoldLines(group.scaffold));
  body.push(lines);
}
if (b.applies.length > 0) {
  // Вложенные области бывают двух видов: строка массива и именованная часть документа.
  const note = !b.appliesParts
    ? '// Строки массивов: у строки своя область — правила её узлов в поведении строки выше.'
    : b.appliesRows
      ? '// Части документа и строки массивов: у каждой своя область — её правила в поведении выше.'
      : '// Части документа: у части своя область — правила её узлов в поведении части выше.';
  body.push([note, ...b.applies]);
}
const rowBody = (row) => {
  const blocks = [];
  const own = [...row.rules.flatMap((rule) => rule.lines), ...scaffoldLines(row.scaffold)];
  if (own.length > 0) blocks.push(own);
  if (row.applies.length > 0) {
    blocks.push([
      row.appliesParts
        ? '// Вложенные части и строки — в своих областях.'
        : '// Вложенные строки — в своей области.',
      ...row.applies,
    ]);
  }
  return blocks;
};
const scopeOf = (names) => (names.length > 0 ? `{ ${names.join(', ')} }` : '');
// Объявление типа области: не помещается в строку — выражение уходит под имя.
const typeLine = (row) => {
  const line = `type ${row.typeName} = ${row.typeExpr};`;
  return it.fits(line) ? line : `type ${row.typeName} =\n  ${row.typeExpr};`;
};
// Тело из одних комментариев пустых строк не держит: форматтер склеивает такие комментарии.
const joinBody = (groups) => (b.hasCode ? it.blocks(groups) : groups.join('\n'));
-%>
// <%= it.layout.files.behavior %> — поведение формы: связи над моделью и правила узлов схемы.
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

<%~ it.imports([...b.imports, 'type BehaviorScope'], '@reformer/core/behaviors') %>
import type { <%= T %> } from '<%= it.rel('behavior', 'types') %>';

<% for (const row of b.rows) { -%>
<% if (row.kind === 'part') { -%>
/** Часть `<%= row.part %>` документа. Тип — по первому подключению: `<%= row.path %>`. */
<%~ typeLine(row) %>

/**
 * Правила части `<%= row.part %>`. Область у части своя: `model`, `form` и `schema.node(…)` здесь —
 * модель, форма и узлы одного её подключения, а не всей формы.
 */
<% } else { -%>
/** Строка массива `<%= row.path %>`. */
<%~ typeLine(row) %>

/**
 * Правила строки массива `<%= row.path %>`. Область у строки своя: `model`, `form` и
 * `schema.node(…)` здесь — модель, форма и узлы одной строки, а не всей формы.
 */
<% } -%>
<%~ it.format(`const ${row.name} = defineFormBehavior<${row.typeName}>((${scopeOf(row.scope)}) => {\n${it.blocks(rowBody(row).map((lines) => it.indent(lines, 2)))}\n});`) %>

<% } -%>
/** Правила поведения формы. Функцией — чтобы сборка добавила к ним отправку (<%= it.layout.files.create %>). */
<%~ it.signature('export function behaviorRules', [`${b.scope.length > 0 ? scopeOf(b.scope) : '_scope'}: BehaviorScope<${T}>`], ': void {') %>
<% if (body.length > 0) { -%>
<%~ joinBody(body.map((lines) => it.indent(lines, 2))) %>
<% } else { -%>
  // Правил пока нет — см. пример ниже.
<% } -%>
}

export const formBehavior = defineFormBehavior<<%= T %>>(behaviorRules);
<% if (!b.hasCode) { -%>

// --- ПРИМЕР ↓ замените функцию выше на такую и оставьте нужные строки ------------------
// import {
//   compute,
//   computeFrom,
//   copyFrom,
//   defineFormBehavior,
//   enableWhen,
//   hideWhen,
//   type BehaviorScope,
// } from '@reformer/core/behaviors';
//
// export function behaviorRules({ model, schema }: BehaviorScope<<%= T %>>): void {
//   // model.field — ЗНАЧЕНИЕ поля, model.$.field — его сигнал. Операторы принимают сигналы.
//   compute(model.$.total, () => (model.price ?? 0) * (model.qty ?? 0));
//   computeFrom([model.$.price, model.$.qty], model.$.total, (price, qty) => price * qty);
//   enableWhen(model.$.city, () => model.country !== null);
//   copyFrom(model.$.shippingAddress, model.$.billingAddress, { when: () => model.sameAddress });
//
//   // Правила узлов схемы — по `selector` узла. Скрытие узла не убирает поле из модели:
//   // чтобы оно перестало валидироваться, рядом нужен enableWhen.
//   hideWhen(schema.node('details-section'), () => !model.hasDetails);
// }
// --- конец примера ---------------------------------------------------------------------
<% } -%>
