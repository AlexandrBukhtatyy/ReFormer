<% const T = it.names.TypeName; -%>
<% const rules = it.step.validation; -%>
// <%= it.step.files.validation %> — правила шага «<%= it.step.title %>»: их проверяет «Далее», отправка — все шаги сразу.
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

<%~ rules.imports.join('\n') %>
import type { <%= T %> } from '<%= it.step.imports.types %>';

/** Правила шага «<%= it.step.title %>»: их проверяет «Далее». */
export const stepRules = defineValidation<<%= T %>>((<%= rules.usesModel ? '{ model }' : '' %>) => {
<% if (rules.body.length > 0) { -%>
<%~ it.indent(rules.body, 2) %>
<% } else { -%>
  // TODO: правила шага
<% } -%>
});
