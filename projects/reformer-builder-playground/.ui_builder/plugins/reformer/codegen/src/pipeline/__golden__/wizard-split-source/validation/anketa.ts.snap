// validation/anketa.ts — правила шага «Данные»: их проверяет «Далее», отправка — все шаги сразу.
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

import { defineValidation, validate } from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
import type { ZayavkaNaKreditForm } from '../types/zayavka-na-kredit';

/** Правила шага «Данные»: их проверяет «Далее». */
export const stepRules = defineValidation<ZayavkaNaKreditForm>(({ model }) => {
  // Заготовка: обязательные поля схемы — правила формы заменят её.
  validate(model.$.name, [required()]);
});
