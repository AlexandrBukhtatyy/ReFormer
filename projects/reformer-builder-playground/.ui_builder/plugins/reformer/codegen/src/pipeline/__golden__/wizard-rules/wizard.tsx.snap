// wizard.tsx — шим под $component(Wizard) и тело шага. Регенерируется.

/* eslint-disable @typescript-eslint/no-explicit-any */
import { useMemo, type ReactNode } from 'react';
import { FormWizard, type FormWizardStep } from '@reformer/ui-kit';
import { createFormFlow, type FormGroup } from '@reformer/core';
import type { ValidationResult } from '@reformer/core/validation';
import { RenderNodeComponent, type RenderNode } from '@reformer/renderer-react';
import type { ZayavkaNaKreditForm } from './types';

/** Проверка шага (номер с единицы): из неё шим строит поток шагов визарда. */
export type WizardStepCheck = (step: number) => Promise<ValidationResult>;

/** Узел шага после конвертации: `title`/`icon` лежат в его `componentProps`. */
interface StepNode {
  componentProps?: { title?: string; icon?: string; [key: string]: unknown };
  [key: string]: unknown;
}

export interface WizardProps {
  /** Приходит от рендерера (см. `__selfManagedChildren`). */
  form?: FormGroup<ZayavkaNaKreditForm>;
  /** Узлы шагов из `componentProps.steps`. */
  steps?: StepNode[];
  className?: string;
  /**
   * Проверка шага — приходит от form.render.ts через `patchProps`. Без неё «Далее»
   * не проверяет шаг: визард пропустил бы пустые обязательные поля.
   */
  validateStep?: WizardStepCheck;
  /** Вешается снаружи — form.render.ts через onComponentEvent(node, 'onSubmit'). */
  onSubmit?: (values: ZayavkaNaKreditForm) => void | Promise<void>;
}

/**
 * Визард: узлы шагов из схемы — в шаги кита. Отрисовку тела шага даём пропом
 * `renderStepBody`: кит намеренно не зависит от `@reformer/renderer-react`.
 */
export function Wizard({
  form,
  steps = [],
  className,
  validateStep,
  onSubmit,
}: WizardProps): ReactNode {
  // Поток шагов: по шагу на узел, «Далее» проверяет шаг через `validateStep`.
  const count = steps.length;
  const flow = useMemo(
    () =>
      count > 0
        ? createFormFlow({
            steps: Array.from({ length: count }, (_, i) => String(i + 1)),
            ...(validateStep ? { validateStep: (id: string) => validateStep(Number(id)) } : {}),
          })
        : undefined,
    [count, validateStep]
  );

  const wizardSteps: FormWizardStep<ZayavkaNaKreditForm, RenderNode<ZayavkaNaKreditForm>>[] = steps.map(
    (node, i) => ({
      number: i + 1,
      title: node.componentProps?.title ?? `Шаг ${i + 1}`,
      icon: node.componentProps?.icon,
      body: node as any,
    })
  );

  return (
    <FormWizard<ZayavkaNaKreditForm, RenderNode<ZayavkaNaKreditForm>>
      form={form as FormGroup<ZayavkaNaKreditForm>}
      className={className}
      steps={wizardSteps}
      {...(flow ? { flow } : {})}
      renderStepBody={(body, wizardForm) => <RenderNodeComponent node={body} form={wizardForm} />}
      onSubmit={onSubmit ? () => onSubmit(form?.getValue() as ZayavkaNaKreditForm) : undefined}
    />
  );
}

// Контракт с рендерером: получить `form` пропом и сырые `steps`, без обхода детей.
(Wizard as any).__selfManagedChildren = true;

export interface StepProps {
  className?: string;
  children?: ReactNode;
}

/**
 * Тело шага — компонент под `$component(Step)`. Маркер: `title`/`icon` из его
 * `componentProps` снимает `Wizard` выше, сюда доезжает только вёрстка.
 */
export function Step({ className, children }: StepProps): ReactNode {
  return <div className={className}>{children}</div>;
}
