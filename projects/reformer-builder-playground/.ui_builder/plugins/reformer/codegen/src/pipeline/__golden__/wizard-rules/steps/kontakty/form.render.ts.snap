// steps/kontakty/form.render.ts — render-слой шага «Контакты»: условная видимость и
// события узлов шага. Вызывается из корневого form.render.ts.

import { hideWhen, type RenderSchemaProxy } from '@reformer/renderer-react';
import type { FormModel, FormGroup } from '@reformer/core';
import type { ZayavkaNaKreditForm } from '../../types';

export function stepRender(
  schema: RenderSchemaProxy<ZayavkaNaKreditForm>,
  ctx: { form: FormGroup<ZayavkaNaKreditForm>; model: FormModel<ZayavkaNaKreditForm> }
): void {
  // form и model — под теми же именами, что в корневом form.render.ts: правила переносятся
  // между файлами без правки (условия hideWhen читают form.<поле>.value.value).
  const { form, model } = ctx;
  void schema;
  void form;
  void model;

  // Правила render-слоя шага (из правил формы — правьте здесь или в панели правил):
  hideWhen(schema.node('kontakty-section'), () => !form.fullName.value.value);
}
