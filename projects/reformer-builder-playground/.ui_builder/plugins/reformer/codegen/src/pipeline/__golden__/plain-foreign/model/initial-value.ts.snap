// model/initial-value.ts — начальные значения формы (из мока). Регенерируется.

import type { ZayavkaNaKreditForm } from '../types/zayavka-na-kredit';

/** Начальные значения: задают форму данных и снимок, к которому возвращает сброс. */
export function createInitialValues(): ZayavkaNaKreditForm {
  return {
    fullName: '',
    agreed: false,
  } as ZayavkaNaKreditForm;
}
