/**
 * Валидация модели визарда. Правила шагов — в steps/<шаг>/form.validation.ts, здесь их
 * сборка и правила полей вне шагов (проверяются только при отправке).
 */
import { validate, defineValidation, apply, applyValidationResult, runValidation, type ValidationResult } from '@reformer/core/validation';
import { maxLength } from '@reformer/core/validators';
import type { ZayavkaNaKreditForm } from './types';
import { type FormModel } from '@reformer/core';
import { stepValidations } from './steps';

export const restValidation = defineValidation<ZayavkaNaKreditForm>(({ model }) => {
  validate(model.$.comment, [maxLength(500)]);
});

/** Полная проверка (отправка): правила всех шагов и поля вне шагов. */
export const formValidation = defineValidation<ZayavkaNaKreditForm>(() => {
  apply(...stepValidations, restValidation);
});

/** Шаг без правил: проверка ничего не находит. */
const noStepRules = defineValidation<ZayavkaNaKreditForm>(() => {});

/**
 * Проверка шага визарда (номер с единицы) — из неё визард строит поток шагов. `touch: true`
 * обязателен: киты показывают ошибку только у тронутого поля, и без него остановленный шаг
 * выглядел бы как неработающая кнопка.
 */
export function makeStepCheck(model: FormModel<ZayavkaNaKreditForm>) {
  return async (step: number): Promise<ValidationResult> => {
    const result = await runValidation(model, stepValidations[step - 1] ?? noStepRules);
    applyValidationResult(result, { touch: true });
    return result;
  };
}
