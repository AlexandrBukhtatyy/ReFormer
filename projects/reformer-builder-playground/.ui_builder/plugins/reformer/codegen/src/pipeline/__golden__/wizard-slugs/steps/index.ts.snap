// Регенерируется билдером (порядок шагов берётся из схемы); правки будут перезаписаны.

import { stepValidation as step1Validation } from './kontakty/form.validation';
import { stepRender as step1Render } from './kontakty/form.render';
import { stepValidation as step2Validation } from './kontakty-2/form.validation';
import { stepRender as step2Render } from './kontakty-2/form.render';
import { stepValidation as step3Validation } from './step-3/form.validation';
import { stepRender as step3Render } from './step-3/form.render';

/** Под-схемы валидации шагов: индекс — номер шага минус один. */
