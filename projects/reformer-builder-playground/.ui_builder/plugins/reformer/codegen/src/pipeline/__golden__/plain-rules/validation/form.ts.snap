// validation/form.ts — валидация формы: поле `validation` сборки (application/create.ts).
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

import type { FormValidation } from '@reformer/core';
import { validate, defineValidation, validateWhen } from '@reformer/core/validation';
import { minLength, required } from '@reformer/core/validators';
import type { ZayavkaNaKreditForm } from '../types/zayavka-na-kredit';

/** Правила формы: проверяются при отправке. */
export const formRules = defineValidation<ZayavkaNaKreditForm>(({ model }) => {
  validate(model.$.fullName, [required(), minLength(2)]);
  validateWhen(() => model.fullName !== null, () => {
    validate(model.$.agreed, [required()]);
  });
});

/** Валидация формы — поле `validation` сборки. Сюда же — стратегия живой проверки (`strategy`). */
export const formValidation: FormValidation<ZayavkaNaKreditForm> = { rules: formRules };
