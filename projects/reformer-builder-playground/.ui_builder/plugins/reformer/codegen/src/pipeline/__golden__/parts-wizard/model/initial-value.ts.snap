  return {
    sameAddress: false,
    home: {
      region: '',
      city: '',
      noApartment: false,
      apartment: '',
    },
    work: {
      region: '',
      city: '',
      noApartment: false,
      apartment: '',
    },
    guests: [],
  } as ZayavkaNaKreditForm;
}
