{
  "$schema": "./form-schema.schema.json",
  "format": 2,
  "version": "1.0",
  "root": {
    "component": "$component(Box)",
    "children": [
      {
        "component": "$component(Wizard)",
        "children": [
          {
            "component": "$component(Step)",
            "componentProps": {
              "title": "Контакты"
            },
            "children": [
              {
                "model": "$model(phone)",
                "component": "$component(Input)",
                "componentProps": {
                  "label": "phone",
                  "required": true
                }
              }
            ],
            "selector": "kontakty-section"
          },
          {
            "component": "$component(Step)",
            "componentProps": {
              "title": "Контакты"
            },
            "children": [
              {
                "model": "$model(email)",
                "component": "$component(Input)",
                "componentProps": {
                  "label": "email",
                  "required": true
                }
              }
            ],
            "selector": "kontakty-section-2"
          },
          {
            "component": "$component(Step)",
            "componentProps": {},
            "children": [
              {
                "model": "$model(note)",
                "component": "$component(Input)",
                "componentProps": {
                  "label": "note",
                  "required": true
                }
              }
            ]
          }
        ],
        "selector": "wizard"
      }
    ]
  }
}
