// validation/kontakty.ts — правила шага «Контакты»: их проверяет «Далее», отправка — все шаги сразу.
// Пока файл не правили руками, билдер перегенерирует его из правил формы; правленный не трогает.

import { validate, defineValidation, validateWhen } from '@reformer/core/validation';
import { email, required } from '@reformer/core/validators';
import type { ZayavkaNaKreditForm } from '../types/zayavka-na-kredit';

/** Правила шага «Контакты»: их проверяет «Далее». */
export const stepRules = defineValidation<ZayavkaNaKreditForm>(({ model }) => {
  validate(model.$.contacts.email, [required(), email()]);
  validateWhen(
    () => model.contacts.email === null,
    () => {
      validate(model.$.contacts.phone, [required()]);
    }
  );
});
