# Сборка для билдера — `npm run build:dev`: он грузит плагин из корня этого каталога.
# Исходники — в src/, сборка для поставки (`npm run build:dist`) — в dist/.
/manifest.json
/main.js
/styles.css
# Модули данных сборки: корпус знаний импортируется отложенно и уезжает из main.js сюда.
/chunks/

# База знаний ассистента — её собирает `npm run generate:knowledge`.
/src/knowledge/generated/

# Таблица стилей плагина — её собирает `npm run generate:styles`: утилиты Tailwind,
# которых нет в CSS билдера (см. `.shared/plugin-styles.mjs`).
/src/styles.css
