{
  "name": "@reformer/builder-reformer-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Плагин ReFormer Builder «Ассистент»: чат с моделью, инструменты правки формы и база знаний ReFormer",
  "scripts": {
    "generate:styles": "node ../../.shared/plugin-styles.mjs",
    "prevalidate": "npm run generate:styles",
    "validate": "reformer-plugin validate src",
    "generate:knowledge": "node ../../../../../../packages/reformer-mcp/scripts/build-knowledge-bundle.mjs --out src/knowledge/generated",
    "prebuild:dev": "npm run generate:knowledge && npm run generate:styles",
    "prebuild:dist": "npm run generate:knowledge && npm run generate:styles",
    "predev": "npm run generate:knowledge && npm run generate:styles",
    "build:dev": "reformer-plugin build src --out .",
    "build:dist": "reformer-plugin build src --out dist --minify",
    "dev": "reformer-plugin dev src --out .",
    "test": "node ../../../../../../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-plugin-cli": "*",
    "@reformer/builder-toolkit": "*",
    "@reformer/core": "*",
    "@reformer/mcp": "*",
    "@reformer/renderer-json": "*",
    "@reformer/ui-kit": "*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "ai": "^7.0.63",
    "ajv": "^8.17.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
