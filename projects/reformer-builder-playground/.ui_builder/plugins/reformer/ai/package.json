{
  "name": "@reformer/builder-reformer-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Плагин ReFormer Builder «Ассистент: формы ReFormer»: стек форм ReFormer в ассистенте — инструменты правки формы, промпт и база знаний ReFormer",
  "scripts": {
    "validate": "reformer-plugin validate src",
    "generate:knowledge": "node ../../../../../../packages/reformer-mcp/scripts/build-knowledge-bundle.mjs --out src/knowledge/generated",
    "prebuild:dev": "npm run generate:knowledge",
    "prebuild:dist": "npm run generate:knowledge",
    "predev": "npm run generate:knowledge",
    "build:dev": "reformer-plugin build src --out .",
    "build:dist": "reformer-plugin build src --out dist --minify",
    "dev": "reformer-plugin dev src --out .",
    "test": "node ../../../../../../scripts/run-vitest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-plugin-cli": "*",
    "@reformer/builder-toolkit": "*",
    "@reformer/core": "*",
    "@reformer/mcp": "*",
    "@reformer/renderer-json": "*",
    "@reformer/ui-kit": "*",
    "ajv": "^8.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
