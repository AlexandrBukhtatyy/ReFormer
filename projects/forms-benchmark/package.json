{
  "name": "forms-benchmark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Страницы бенчмарка: одна форма на одну библиотеку (ReFormer core/json, Formik, React Hook Form, RJSF)",
  "scripts": {
    "dev": "vite",
    "bench:build": "node scripts/build-entries.mjs",
    "bench:build:frameworks": "node scripts/build-frameworks.mjs",
    "serve": "node scripts/serve.mjs",
    "size": "node scripts/bundle-size.mjs",
    "loc": "node scripts/code-size.mjs",
    "size:frameworks": "node scripts/bundle-size.mjs --frameworks",
    "loc:frameworks": "node scripts/code-size.mjs --frameworks",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.2",
    "@preact/signals-core": "^1.8.0",
    "@reformer/cdk": "*",
    "@reformer/core": "*",
    "@reformer/renderer-json": "*",
    "@reformer/renderer-react": "*",
    "@rjsf/core": "6.10.1",
    "@rjsf/utils": "6.10.1",
    "@rjsf/validator-ajv8": "6.10.1",
    "formik": "2.4.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "7.91.0",
    "yup": "1.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "source-map-explorer": "2.5.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
