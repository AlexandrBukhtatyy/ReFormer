{
  "name": "@reformer/builder-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Вторая версия визуального конструктора форм ReFormer: собранный офлайн-SPA, запускаемый через npx у разработчика; конфигурация — каталогом .ui_builder. private снимается решением о публикации.",
  "type": "module",
  "bin": {
    "reformer-builder2": "./bin/reformer-builder2.mjs"
  },
  "files": [
    "dist",
    "bin",
    "runtime-config.schema.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "generate:knowledge": "node ../../packages/reformer-mcp/scripts/build-knowledge-bundle.mjs --out src/plugins/ai/knowledge/generated",
    "build": "npm run generate:knowledge && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:browser": "node ../../scripts/run-vitest.mjs -c vitest.browser.config.ts",
    "test:watch": "vitest watch",
    "predev": "npm run generate:knowledge"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@eslint/js": "^9.39.1",
    "@monaco-editor/react": "^4.7.0",
    "@preact/signals-core": "^1.8.0",
    "@reformer/cdk": "*",
    "@reformer/core": "*",
    "@reformer/mcp": "*",
    "@reformer/renderer-json": "*",
    "@reformer/renderer-react": "*",
    "@reformer/ui-kit": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser": "^4.0.15",
    "@vitest/browser-playwright": "^4.0.15",
    "ai": "^7.0.63",
    "ajv": "^8.17.1",
    "cmdk": "^1.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eta": "^4.6.0",
    "globals": "^16.5.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.553.0",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.6.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
