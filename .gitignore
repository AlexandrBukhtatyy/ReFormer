projects/reformer-builder/.ui_builder/

# Слоты стендов MCP (калибровка, сценарии): страницы и их `routes.tsx` пишет стенд при запуске,
# `App.tsx` подхватывает любой `pages/debug/<слот>/routes.tsx`.
projects/react-playground/src/pages/debug/mcp-*/

