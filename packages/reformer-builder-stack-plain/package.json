{
  "name": "@reformer/builder-stack-plain",
  "version": "0.0.0",
  "private": true,
  "description": "Demo stack for ReFormer Builder: a flat field-list schema, native rendering and a plain React Form.tsx printer — proof that the builder seams admit a non-ReFormer stack",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:stackblitz": "vite build",
    "test": "node ../../scripts/run-vitest.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-builder-stack-plain"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@reformer/builder-toolkit": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  }
}
