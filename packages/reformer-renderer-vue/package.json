{
  "name": "@reformer/renderer-vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue renderer for @reformer/core forms",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:stackblitz": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "vue",
    "forms",
    "reformer",
    "renderer",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-renderer-vue"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@reformer/core": "*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@reformer/core": "*",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.6",
    "renderer-contract": "*",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8",
    "vue": "^3.5.13"
  }
}
