{
  "name": "@reformer/kit-taiga",
  "version": "0.0.0",
  "private": true,
  "description": "ReFormer kit on Taiga UI 5: standalone components under catalog names for renderer-json forms drawn by @reformer/renderer-angular",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/reformer-kit-taiga.d.ts",
      "default": "./dist/fesm2022/reformer-kit-taiga.mjs"
    },
    "./catalog": "./component-catalog.json",
    "./styles.css": "./styles.css",
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "ngc -p tsconfig.spec.json --noEmit",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "angular",
    "taiga-ui",
    "forms",
    "reformer",
    "kit"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-kit-taiga"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@reformer/core": "*",
    "@reformer/renderer-angular": "*",
    "@taiga-ui/core": "^5.34.0",
    "@taiga-ui/kit": "^5.34.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.8",
    "@analogjs/vitest-angular": "2.9.8",
    "@angular/build": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@reformer/builder-plugin-api": "*",
    "@reformer/core": "*",
    "@reformer/renderer-angular": "*",
    "@reformer/renderer-json": "*",
    "@taiga-ui/core": "5.34.0",
    "@taiga-ui/kit": "5.34.0",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.6",
    "kit-fixtures": "*",
    "ng-packagr": "^21.2.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
