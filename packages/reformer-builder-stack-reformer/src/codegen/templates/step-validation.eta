<% if (it.step.validationCode !== null) { -%>
<%~ it.step.validationCode -%>
<% } else { -%>
// steps/<%= it.step.dir %>/form.validation.ts — валидация шага «<%= it.step.title %>». «Далее» проверяет только эти
// правила, отправка — все шаги сразу. МОК: required выведены из схемы, допишите правила.
// Пишется один раз и при регенерации не затирается.

<% if (it.step.required.length > 0) { -%>
import { validate, defineValidationSchema } from '@reformer/core/validation';
import { required } from '@reformer/core/validators';
<% } else { -%>
import { defineValidationSchema } from '@reformer/core/validation';
<% } -%>
import type { <%= it.names.TypeName %> } from '<%= it.step.imports.types %>';

<% if (it.step.required.length > 0) { -%>
export const stepValidation = defineValidationSchema<<%= it.names.TypeName %>>(({ model }) => {
<% for (const path of it.step.required) { -%>
  validate(model.$.<%= path %>, [required({ message: 'Обязательное поле' })]);
<% } -%>
});
<% } else { -%>
export const stepValidation = defineValidationSchema<<%= it.names.TypeName %>>(() => {
  // TODO: правила шага
});
<% } -%>
<% } -%>
