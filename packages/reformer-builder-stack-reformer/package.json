{
  "name": "@reformer/builder-stack-reformer",
  "version": "0.0.0",
  "description": "ReFormer stack for ReFormer Builder: form-schema model, component catalog, kit descriptors, mock data, fixtures and the codegen printer for @reformer/renderer-json forms",
  "type": "module",
  "exports": {
    "./form-model": {
      "types": "./dist/form-model/index.d.ts",
      "import": "./dist/form-model/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./kits": {
      "types": "./dist/kits/index.d.ts",
      "import": "./dist/kits/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    },
    "./form-mock": {
      "types": "./dist/form-mock/index.d.ts",
      "import": "./dist/form-mock/index.js"
    },
    "./form-fixture": {
      "types": "./dist/form-fixture/index.d.ts",
      "import": "./dist/form-fixture/index.js"
    },
    "./form-inspect": {
      "types": "./dist/form-inspect/index.d.ts",
      "import": "./dist/form-inspect/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:stackblitz": "vite build",
    "test": "node ../../scripts/run-vitest.mjs"
  },
  "keywords": [
    "reformer",
    "builder",
    "form-builder",
    "codegen",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-builder-stack-reformer"
  },
  "homepage": "https://alexandrbukhtatyy.github.io/ReFormer/",
  "bugs": {
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@reformer/builder-plugin-api": "*",
    "@reformer/builder-toolkit": "*"
  },
  "peerDependencies": {
    "@reformer/core": "*",
    "@reformer/mcp": "*",
    "@reformer/renderer-json": "*",
    "@reformer/ui-kit": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8"
  }
}
