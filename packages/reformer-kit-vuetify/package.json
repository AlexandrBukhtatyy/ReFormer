{
  "name": "@reformer/kit-vuetify",
  "version": "0.0.0",
  "private": true,
  "description": "ReFormer kit on Vuetify 4: components under catalog names for renderer-json forms drawn by @reformer/renderer-vue",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": "./component-catalog.json",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "vue",
    "vuetify",
    "forms",
    "reformer",
    "kit"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-kit-vuetify"
  },
  "files": [
    "dist",
    "component-catalog.json",
    "styles.css",
    "README.md"
  ],
  "peerDependencies": {
    "@reformer/core": "*",
    "@reformer/renderer-vue": "*",
    "vue": "^3.5.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@reformer/builder-plugin-api": "*",
    "@reformer/core": "*",
    "@reformer/renderer-json": "*",
    "@reformer/renderer-vue": "*",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.6",
    "kit-fixtures": "*",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.8",
    "vue": "^3.5.13",
    "vuetify": "4.3.4"
  }
}
