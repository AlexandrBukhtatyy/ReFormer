{
  "name": "@reformer/renderer-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Angular renderer for @reformer/core forms",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/reformer-renderer-angular.d.ts",
      "default": "./dist/fesm2022/reformer-renderer-angular.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "typecheck": "ngc -p tsconfig.spec.json --noEmit",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "angular",
    "forms",
    "reformer",
    "renderer",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-renderer-angular"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@reformer/core": "*"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.9.8",
    "@analogjs/vitest-angular": "2.9.8",
    "@angular/build": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@reformer/core": "*",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.6",
    "ng-packagr": "^21.2.0",
    "renderer-contract": "*",
    "rxjs": "^7.8.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
