{
  "name": "@reformer/mcp",
  "version": "6.0.0",
  "description": "MCP server for ReFormer form library - provides AI assistants with comprehensive documentation and tools for form development",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./core": "./dist/core/knowledge.js",
    "./browser": "./dist/platform/browser/knowledge.js",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "bin": {
    "reformer-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "llms-index.json",
    "docs/llms"
  ],
  "scripts": {
    "generate:llms": "node ../../scripts/generate-llms-txt .",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run generate:llms && tsc && node scripts/copy-templates.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node ../../scripts/run-vitest.mjs",
    "test:watch": "vitest watch",
    "check:packaging": "node scripts/check-packaging.mjs"
  },
  "keywords": [
    "mcp",
    "reformer",
    "claude",
    "ai",
    "forms",
    "react",
    "model-context-protocol"
  ],
  "author": "Alexandr Bukhtatyy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandrBukhtatyy/ReFormer.git",
    "directory": "packages/reformer-mcp"
  },
  "bugs": {
    "url": "https://github.com/AlexandrBukhtatyy/ReFormer/issues"
  },
  "homepage": "https://github.com/AlexandrBukhtatyy/ReFormer/tree/main/packages/reformer-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "handlebars": "^4.7.9"
  },
  "optionalDependencies": {
    "@reformer/renderer-json": "*"
  },
  "peerDependencies": {
    "@reformer/core": "*",
    "@reformer/cdk": "*",
    "@reformer/renderer-react": "*",
    "@reformer/ui-kit": "*",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@reformer/core": {
      "optional": true
    },
    "@reformer/cdk": {
      "optional": true
    },
    "@reformer/renderer-react": {
      "optional": true
    },
    "@reformer/ui-kit": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
