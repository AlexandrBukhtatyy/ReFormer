[
  {
    "name": "form_start",
    "description": "Start a form: the server plans the stages of the work (fields, rows, steps, validation, reactions, markup) and saves the plan to <dir>/form.plan.json. Call it first, once per form. Then change the form only with form_edit — every answer ends with the exact next call.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Form folder (default \"form\")."
        },
        "target": {
          "type": "string",
          "enum": [
            "core",
            "renderer-react",
            "renderer-json"
          ],
          "description": "The stack named in the task."
        },
        "task": {
          "type": "string",
          "description": "The task text word for word, in its own language: do not translate or retell it."
        },
        "specPath": {
          "type": "string",
          "description": "A markdown spec of the form, if the task has one: the server drafts the form from it."
        },
        "formName": {
          "type": "string",
          "description": "Form title in the language of the task."
        }
      },
      "required": [
        "target"
      ]
    }
  },
  {
    "name": "form_edit",
    "description": "Change the form with small edits; the server keeps the form and builds the module — never write files of the form folder yourself. Edits are applied one by one: a rejected edit says how to fix it, the others still apply. \"edits\":[] just builds. Names, labels and texts come from the task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Form folder (default \"form\")."
        },
        "edits": {
          "type": "array",
          "description": "add_field {name,label,type?,options?,mask?,placeholder?,readonly?,step?} · set_field {name,…} · rename_field {name,to,label?} · remove_field {name} · add_array {name,label,minItems?,maxItems?} · add_item_field {array,name,label,type?} · add_step {title,fields} · rename_step {title,to} · remove_step {title} · place {name,step} · add_rule {field,array?,required?,email?,min?,max?,minLength?,maxLength?,pattern?,rule?,cross?,when?,message?} · remove_rule {field,rule?} · add_behavior {kind,target,expr,array?,when?,resetOnDisable?} · remove_behavior {target,kind?} · add_visibility {field,showWhen|hideWhen} · set_form {formName} · markup (core: the server writes index.tsx)",
          "items": {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "add_field",
                  "set_field",
                  "rename_field",
                  "remove_field",
                  "add_array",
                  "add_item_field",
                  "add_step",
                  "rename_step",
                  "remove_step",
                  "place",
                  "add_rule",
                  "remove_rule",
                  "add_behavior",
                  "remove_behavior",
                  "add_visibility",
                  "set_form",
                  "markup"
                ]
              },
              "name": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date"
                ]
              },
              "component": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "object"
                  ]
                }
              },
              "mask": {
                "type": "string"
              },
              "placeholder": {
                "type": "string"
              },
              "readonly": {
                "type": "boolean"
              },
              "initialValue": {},
              "step": {
                "type": "string"
              },
              "array": {
                "type": "string"
              },
              "minItems": {
                "type": "number"
              },
              "maxItems": {
                "type": "number"
              },
              "title": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "boolean"
              },
              "email": {
                "type": "boolean"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "minLength": {
                "type": "number"
              },
              "maxLength": {
                "type": "number"
              },
              "pattern": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "cross": {
                "type": "string"
              },
              "equals": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "compute",
                  "computeFrom",
                  "copyFrom",
                  "syncFields",
                  "onChange",
                  "enableWhen",
                  "disableWhen",
                  "resetWhen",
                  "transformValue",
                  "revalidateWhen",
                  "exclusiveFlag",
                  "aggregateInto"
                ]
              },
              "target": {
                "type": "string"
              },
              "expr": {
                "type": "string"
              },
              "resetOnDisable": {
                "type": "boolean"
              },
              "showWhen": {
                "type": "string"
              },
              "hideWhen": {
                "type": "string"
              },
              "formName": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "op"
            ]
          }
        }
      },
      "required": [
        "edits"
      ]
    }
  },
  {
    "name": "form_status",
    "description": "The plan of the form: which stages are done, whether the last build passed, the next call. \"skip\" drops a stage the task does not need, \"add\" adds one it needs (validation, cross, behavior, arrays, wizard).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Form folder (default \"form\")."
        },
        "skip": {
          "type": "string",
          "enum": [
            "arrays",
            "wizard",
            "validation",
            "cross",
            "behavior"
          ]
        },
        "add": {
          "type": "string",
          "enum": [
            "arrays",
            "wizard",
            "validation",
            "cross",
            "behavior"
          ]
        },
        "confirm": {
          "type": "string",
          "enum": [
            "validation",
            "edit"
          ],
          "description": "The form was checked against the task: \"validation\" — every limit it names has a rule; \"edit\" — every change it names is made."
        }
      },
      "required": []
    }
  },
  {
    "name": "form_build",
    "description": "Build the module again from the current form files. form_edit already builds after every edit — call this only when an answer asks to build. The answer ends with the plan and \"Next:\".",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Form folder (default \"form\")."
        }
      },
      "required": []
    }
  }
]
