                      "testId": "businessInn",
                      "label": "ИНН ИП"
                    }
                  },
                  {
                    "selector": "businessActivity",
                    "model": "$model(businessActivity)",
                    "component": "$component(Textarea)",
                    "componentProps": {
                      "placeholder": "Опишите вид деятельности",
                      "rows": 3,
                      "testId": "businessActivity",
                      "label": "Вид деятельности"
                    }
                  }
                ]
              },
              {
                "selector": "income-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Доход",
                  "titleClassName": "text-lg font-semibold mt-6",
                  "className": "space-y-4"
                },
                "children": [
                  {
                    "selector": "monthlyIncome",
                    "model": "$model(monthlyIncome)",
                    "component": "$component(InputNumber)",
                    "componentProps": {
                      "placeholder": "0",
                      "min": 10000,
                      "step": 1000,
                      "testId": "monthlyIncome",
                      "label": "Ежемесячный доход (₽)"
                    }
                  },
                  {
                    "component": "$component(Box)",
                    "componentProps": {
                      "className": "grid grid-cols-2 gap-4"
                    },
                    "children": [
                      {
                        "selector": "additionalIncome",
                        "model": "$model(additionalIncome)",
                        "component": "$component(InputNumber)",
                        "componentProps": {
                          "placeholder": "0",
                          "min": 0,
                          "step": 1000,
                          "testId": "additionalIncome",
                          "label": "Дополнительный доход (₽)"
                        }
                      },
                      {
                        "selector": "additionalIncomeSource",
                        "model": "$model(additionalIncomeSource)",
                        "component": "$component(Input)",
                        "componentProps": {
                          "placeholder": "Опишите источник",
                          "testId": "additionalIncomeSource",
                          "label": "Источник дополнительного дохода"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "selector": "unemployed-warning",
                "component": "$html(div)",
                "componentProps": {
                  "data-testid": "unemployed-warning",
                  "className": "mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-md"
                },
                "children": [
                  {
                    "component": "$component(Section)",
                    "componentProps": {
                      "title": "Обратите внимание: для получения кредита без подтвержденного дохода могут потребоваться дополнительные документы и поручители.",
                      "titleAs": "h4",
                      "titleClassName": "text-sm font-normal text-yellow-800"
                    },
                    "children": []
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "selector": "additional",
        "component": "$component(Step)",
        "componentProps": {
          "title": "Доп. инфо"
        },
        "children": [
          {
            "component": "$component(Section)",
            "componentProps": {
              "title": "Дополнительная информация",
              "titleAs": "h2",
              "titleClassName": "text-xl font-bold",
              "className": "space-y-6"
            },
            "children": [
              {
                "component": "$component(Section)",
