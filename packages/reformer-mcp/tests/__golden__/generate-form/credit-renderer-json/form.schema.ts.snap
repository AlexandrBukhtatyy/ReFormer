                          },
                          {
                            "selector": "workExperienceCurrent",
                            "model": "$model(workExperienceCurrent)",
                            "component": "$component(InputNumber)",
                            "componentProps": {
                              "placeholder": "0",
                              "min": 0,
                              "testId": "workExperienceCurrent",
                              "label": "Стаж на текущем месте (месяцев)"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "selector": "business-section",
                "component": "$component(Section)",
                "componentProps": {
                  "title": "Информация о бизнесе",
                  "titleClassName": "text-lg font-semibold mt-6",
                  "className": "space-y-4"
                },
                "children": [
                  {
                    "selector": "businessType",
                    "model": "$model(businessType)",
