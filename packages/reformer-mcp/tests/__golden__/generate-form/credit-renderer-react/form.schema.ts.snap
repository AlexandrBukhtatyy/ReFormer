/**
 * Схема формы «Заявка на кредит» — одно дерево узлов на все способы реализации.
 *
 * Узел привязан к модели ключом `model`: поле, массив под-форм (`item`) или подформа
 * (`part`). По этому дереву сборка `createForm` строит форму, а `FormRenderer` рисует
 * разметку. Кто рисует разметку сам, в JSX, берёт из схемы только поля.
 */
import type { FormModel, FormSchemaNode } from '@reformer/core';
import { Step } from '@reformer/cdk/form-wizard';
import {
  Box,
  CheckboxWithLabel,
  FieldArray,
  FileUploadDropzone,
  FormWizard,
  Input,
  InputMask,
  InputNumber,
  RadioGroupOptions,
  Section,
  SelectAsync,
  Textarea,
} from '@reformer/ui-kit';
import {
  EDUCATIONS,
  EMPLOYMENT_STATUSES,
  EXISTING_LOAN_TYPES,
  GENDERS,
  LOAN_TYPES,
  MARITAL_STATUSES,
  RELATIONSHIPS,
} from './data-sources';
import type { CreditApplicationForm, Property, ExistingLoan, CoBorrower } from './model';

/** Подформа: пути — от группы, к которой часть подключена. */
const address = (model: FormModel<CreditApplicationForm['registrationAddress']>): FormSchemaNode => ({
  component: Box,
  componentProps: { className: 'space-y-4' },
  children: [
    {
      component: Box,
      componentProps: { className: 'grid grid-cols-2 gap-4' },
      children: [
        {
          selector: 'region',
          model: model.$.region,
          component: Input,
          componentProps: { placeholder: 'Введите регион', label: 'Регион' },
        },
        {
          selector: 'city',
          model: model.$.city,
          component: Input,
          componentProps: { placeholder: 'Введите город', label: 'Город' },
        },
      ],
    },
    {
      selector: 'street',
      model: model.$.street,
      component: Input,
      componentProps: { placeholder: 'Введите улицу', label: 'Улица' },
    },
    {
      component: Box,
      componentProps: { className: 'grid grid-cols-3 gap-4' },
      children: [
        {
          selector: 'house',
          model: model.$.house,
          component: Input,
          componentProps: { placeholder: '№', label: 'Дом' },
        },
        {
          selector: 'apartment',
          model: model.$.apartment,
          component: Input,
          componentProps: { placeholder: '№', label: 'Квартира' },
        },
        {
          selector: 'postalCode',
          model: model.$.postalCode,
          component: InputMask,
          componentProps: { placeholder: '000000', mask: '999999', label: 'Индекс' },
        },
      ],
    },
  ],
});

/** Строка массива: пути — от элемента. Шаблон нового элемента объявлен в `model.ts`. */
const propertiesRow = (model: FormModel<Property>): FormSchemaNode => ({
  component: 'div',
  children: [
    {
      selector: 'type',
      model: model.$.type,
      component: SelectAsync,
      componentProps: {
        placeholder: 'Выберите тип',
        options: [
          { value: 'apartment', label: 'Квартира' },
          { value: 'house', label: 'Дом' },
          { value: 'land', label: 'Земельный участок' },
          { value: 'commercial', label: 'Коммерческая недвижимость' },
          { value: 'car', label: 'Автомобиль' },
          { value: 'other', label: 'Другое' },
        ],
        testId: 'property-type',
        label: 'Тип имущества',
      },
    },
    {
      selector: 'description',
      model: model.$.description,
      component: Textarea,
      componentProps: {
        placeholder: 'Опишите имущество',
        rows: 2,
        testId: 'property-description',
        label: 'Описание',
      },
    },
    {
      selector: 'estimatedValue',
      model: model.$.estimatedValue,
      component: InputNumber,
      componentProps: {
        placeholder: '0',
        min: 0,
        step: 1000,
        testId: 'property-estimatedValue',
        label: 'Оценочная стоимость',
      },
    },
    {
      selector: 'hasEncumbrance',
      model: model.$.hasEncumbrance,
      component: CheckboxWithLabel,
      componentProps: {
        testId: 'property-hasEncumbrance',
        label: 'Имеется обременение (залог)',
      },
    },
  ],
});

/** Строка массива: пути — от элемента. Шаблон нового элемента объявлен в `model.ts`. */
