{
  "description": "Форма потеряла межполевое правило спеки: физлицо проходит с оплатой по счёту.",
  "scenario": "order-create",
  "target": "renderer-react",
  "expectFailure": "runtime.probe.invoice-only-for-company",
  "mutations": [
    {
      "file": "form.validation.ts",
      "find": "values.paymentMethod !== 'invoice' || values.customerType === 'company'",
      "replace": "true"
    }
  ]
}
