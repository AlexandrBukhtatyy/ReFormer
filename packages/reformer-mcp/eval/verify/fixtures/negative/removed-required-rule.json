{
  "description": "Снято правило обязательности адреса: условное поле перестаёт проверяться.",
  "scenario": "order-create",
  "target": "renderer-react",
  "expectFailure": "runtime.probe.delivery-address-required",
  "mutations": [
    {
      "file": "form.validation.ts",
