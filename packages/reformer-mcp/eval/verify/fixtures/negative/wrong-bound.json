{
  "description": "Перепутана граница правила длины.",
  "scenario": "registration-create",
  "target": "renderer-react",
  "expectFailure": "runtime.probe.login-too-short",
  "mutations": [
    {
      "file": "form.validation.ts",
      "find": "minLength(3, { code: 'login.minLength' })",
      "replace": "minLength(1, { code: 'login.minLength' })"
    }
  ]
}
