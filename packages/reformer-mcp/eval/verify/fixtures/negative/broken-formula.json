{
  "description": "Сломанная формула: итог не учитывает скидку.",
  "scenario": "order-create",
  "target": "core",
  "expectFailure": "runtime.probe.total-with-discount",
  "mutations": [
    {
      "file": "form.behavior.ts",
      "find": "(1 - (discount ?? 0) / 100)",
      "replace": "1"
    }
  ]
}
