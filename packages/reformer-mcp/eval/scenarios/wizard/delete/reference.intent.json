{
  "formName": "OrderWizard",
  "interfaceName": "Order",
  "target": "renderer-react",
  "fields": [
    {
      "name": "customerType",
      "type": "string",
      "component": "RadioGroup",
      "label": "Тип покупателя",
      "initialValue": "person",
      "componentProps": {
        "options": [
          { "value": "person", "label": "Физическое лицо" },
          { "value": "company", "label": "Юридическое лицо" }
        ]
      }
    },
    {
      "name": "contact.lastName",
      "type": "string",
      "component": "Input",
      "label": "Фамилия",
      "initialValue": ""
    },
    {
      "name": "contact.firstName",
      "type": "string",
      "component": "Input",
      "label": "Имя",
      "initialValue": ""
    },
    {
      "name": "email",
      "type": "string",
      "component": "Input",
      "label": "Email",
      "initialValue": "",
      "componentProps": { "type": "email" }
    },
    {
      "name": "phone",
      "type": "string",
      "component": "InputMask",
      "label": "Телефон",
      "initialValue": "",
      "componentProps": { "mask": "+7 (999) 999-99-99" }
    },
    {
      "name": "birthDate",
      "type": "date",
      "component": "Input",
      "label": "Дата рождения",
      "initialValue": "",
      "componentProps": { "type": "date" }
    },
    {
      "name": "subtotal",
      "type": "number",
      "component": "InputNumber",
      "label": "Сумма товаров",
      "initialValue": 0,
      "componentProps": { "readOnly": true }
    },
    {
      "name": "promoCode",
      "type": "string",
      "component": "Input",
      "label": "Промокод",
      "initialValue": ""
    },
    {
      "name": "discount",
      "type": "number",
      "component": "Slider",
      "label": "Скидка, %",
      "initialValue": 0,
      "componentProps": { "min": 0, "max": 30, "step": 5 }
    },
    {
      "name": "total",
      "type": "number",
      "component": "InputNumber",
      "label": "Итого",
      "initialValue": 0,
      "componentProps": { "readOnly": true }
    },
    {
      "name": "paymentMethod",
      "type": "string",
      "component": "RadioGroup",
      "label": "Способ оплаты",
      "initialValue": "card",
      "componentProps": {
        "options": [
          { "value": "card", "label": "Картой онлайн" },
          { "value": "cash", "label": "При получении" },
          { "value": "invoice", "label": "По счёту" }
        ]
      }
    },
    {
      "name": "receiptEmail",
      "type": "string",
      "component": "Input",
      "label": "Email для чека",
      "initialValue": "",
      "componentProps": { "type": "email" }
    },
    {
      "name": "comment",
      "type": "string",
      "component": "Textarea",
      "label": "Комментарий к заказу",
      "initialValue": ""
    },
    {
      "name": "agreeTerms",
      "type": "boolean",
      "component": "Checkbox",
      "label": "Согласен с условиями оферты",
      "initialValue": false
    },
    {
      "name": "newsletter",
      "type": "boolean",
      "component": "Switch",
      "label": "Получать новости и акции",
      "initialValue": false
    },
    {
      "name": "sources",
      "type": "array",
      "component": "SelectMulti",
      "label": "Как вы о нас узнали",
      "initialValue": [],
      "optionsSource": "SOURCES"
    }
  ],
  "arrays": [
    {
      "name": "items",
      "itemInterfaceName": "OrderItem",
      "initialValue": [{ "title": "", "quantity": 1, "price": null, "lineTotal": 0 }],
      "componentProps": {
        "title": "Товары",
        "addButtonLabel": "+ Добавить товар",
        "itemLabel": "Товар",
        "minItems": 1,
        "maxItems": 10
      },
      "itemFields": [
        {
          "name": "title",
          "type": "string",
          "component": "Input",
          "label": "Наименование",
          "initialValue": ""
        },
        {
          "name": "quantity",
          "type": "number",
          "component": "InputNumber",
          "label": "Количество",
          "initialValue": 1
        },
        {
          "name": "price",
          "type": "number",
          "component": "InputNumber",
          "label": "Цена",
          "initialValue": null
        },
        {
          "name": "lineTotal",
          "type": "number",
          "component": "InputNumber",
          "label": "Сумма",
          "initialValue": 0,
          "componentProps": { "readOnly": true }
        }
      ]
    },
    {
      "name": "recipients",
      "itemInterfaceName": "Recipient",
      "initialValue": [{ "email": "", "primary": true }],
      "componentProps": {
        "title": "Кому отправлять уведомления",
        "addButtonLabel": "+ Добавить получателя",
        "itemLabel": "Получатель",
        "minItems": 1
      },
      "itemFields": [
        {
          "name": "email",
          "type": "string",
          "component": "Input",
          "label": "Email получателя",
          "initialValue": ""
        },
        {
          "name": "primary",
          "type": "boolean",
          "component": "Checkbox",
          "label": "Основной получатель",
          "initialValue": false
        }
      ]
    }
  ],
  "layoutRoot": {
    "kind": "container",
    "component": "FormWizard",
    "selector": "wizard",
    "componentProps": {
      "submitLabel": "Оформить заказ"
    },
    "children": [
      {
        "kind": "step",
        "title": "Покупатель",
        "selector": "buyer",
        "children": [
          "customerType",
          "contact.lastName",
          "contact.firstName",
          "email",
          "phone",
          "birthDate"
        ]
      },
      {
        "kind": "step",
        "title": "Товары",
        "selector": "goods",
        "children": [
          {
            "kind": "array",
            "ref": "items"
          },
          "subtotal"
        ]
      },
      {
        "kind": "step",
        "title": "Оплата",
        "selector": "payment",
        "children": ["promoCode", "discount", "total", "paymentMethod", "receiptEmail", "comment"]
      },
      {
        "kind": "step",
        "title": "Подтверждение",
        "selector": "confirmation",
        "children": [
          {
            "kind": "array",
            "ref": "recipients"
          },
          "agreeTerms",
          "newsletter",
          "sources"
        ]
      }
    ]
  },
  "validation": [
    {
      "target": "customerType",
      "rules": ["required({ code: 'customerType.required' })"],
      "message": "Выберите тип покупателя"
    },
    {
      "target": "contact.lastName",
      "rules": ["required({ code: 'lastName.required' })"],
      "message": "Введите фамилию"
    },
    {
      "target": "contact.lastName",
      "rules": ["minLength(2, { code: 'lastName.minLength' })"],
      "message": "Минимум 2 символа"
    },
    {
      "target": "contact.firstName",
      "rules": ["required({ code: 'firstName.required' })"],
      "message": "Введите имя"
    },
    {
      "target": "contact.firstName",
      "rules": ["minLength(2, { code: 'firstName.minLength' })"],
      "message": "Минимум 2 символа"
    },
    {
      "target": "email",
      "rules": ["required({ code: 'email.required' })"],
      "message": "Введите email"
    },
    {
      "target": "email",
      "rules": ["email({ code: 'email.format' })"],
      "message": "Некорректный email"
    },
    {
      "target": "phone",
      "rules": ["required({ code: 'phone.required' })"],
      "message": "Введите телефон"
    },
    {
      "target": "phone",
      "rules": ["pattern(/^\\+7 \\(\\d{3}\\) \\d{3}-\\d{2}-\\d{2}$/, { code: 'phone.format' })"],
      "message": "Формат +7 (999) 999-99-99"
    },
    {
      "target": "birthDate",
      "when": "model.customerType === 'person'",
      "rules": ["required({ code: 'birthDate.required' })"],
      "message": "Укажите дату рождения"
    },
    {
      "target": "birthDate",
      "when": "model.customerType === 'person'",
      "rules": ["minAge(18, { code: 'birthDate.minAge' })"],
      "message": "Покупателю должно быть не меньше 18 лет"
    },
    {
      "target": "items",
      "rules": ["minLength(1, { code: 'items.minLength' })"],
      "message": "Добавьте хотя бы один товар"
    },
    {
      "target": "items",
      "rules": ["maxLength(10, { code: 'items.maxLength' })"],
      "message": "Не больше 10 товаров"
    },
    {
      "target": "title",
      "each": "items",
      "rules": ["required({ code: 'item.title.required' })"],
      "message": "Введите наименование"
    },
    {
      "target": "quantity",
      "each": "items",
      "rules": ["required({ code: 'item.quantity.required' })"],
      "message": "Укажите количество"
    },
    {
      "target": "quantity",
      "each": "items",
      "rules": ["integer({ code: 'item.quantity.integer' })"],
      "message": "Количество — целое число"
    },
    {
      "target": "quantity",
      "each": "items",
      "rules": ["min(1, { code: 'item.quantity.min' })"],
      "message": "Минимум 1"
    },
    {
      "target": "quantity",
      "each": "items",
      "rules": ["max(99, { code: 'item.quantity.max' })"],
      "message": "Максимум 99"
    },
    {
      "target": "price",
      "each": "items",
      "rules": ["required({ code: 'item.price.required' })"],
      "message": "Укажите цену"
    },
    {
      "target": "price",
      "each": "items",
      "rules": ["nonNegative({ code: 'item.price.nonNegative' })"],
      "message": "Цена не может быть отрицательной"
    },
    {
      "target": "promoCode",
      "async": "async (value) => { if (!value) return null; await new Promise((resolve) => setTimeout(resolve, 300)); return ['SALE10', 'SALE20'].includes(String(value)) ? null : { code: 'promoCode.unknown' }; }",
      "code": "promoCode.unknown",
      "message": "Промокод не найден"
    },
    {
      "target": "discount",
      "rules": ["min(0, { code: 'discount.min' })"],
      "message": "Скидка не может быть отрицательной"
    },
    {
      "target": "discount",
      "rules": ["max(30, { code: 'discount.max' })"],
      "message": "Скидка не больше 30%"
    },
    {
      "target": "total",
      "cross": "values.total <= 100000",
      "code": "total.large",
      "severity": "warning",
      "message": "Крупный заказ: менеджер свяжется для подтверждения"
    },
    {
      "target": "paymentMethod",
      "rules": ["required({ code: 'paymentMethod.required' })"],
      "message": "Выберите способ оплаты"
    },
    {
      "target": "paymentMethod",
      "cross": "values.paymentMethod !== 'invoice' || values.customerType === 'company'",
      "code": "paymentMethod.invoice",
      "message": "Оплата по счёту — только для юридических лиц"
    },
    {
      "target": "receiptEmail",
      "rules": ["email({ code: 'receiptEmail.format' })"],
      "message": "Некорректный email для чека"
    },
    {
      "target": "comment",
      "rules": ["maxLength(500, { code: 'comment.maxLength' })"],
      "message": "Не больше 500 символов"
    },
    {
      "target": "email",
      "each": "recipients",
      "rules": ["required({ code: 'recipient.email.required' })"],
      "message": "Введите email получателя"
    },
    {
      "target": "email",
      "each": "recipients",
      "rules": ["email({ code: 'recipient.email.format' })"],
      "message": "Некорректный email получателя"
    },
    {
      "target": "agreeTerms",
      "rules": ["required({ code: 'agreeTerms.required' })"],
      "message": "Нужно принять условия оферты"
    }
  ],
  "behavior": [
    {
      "kind": "compute",
      "each": "items",
      "target": "lineTotal",
      "sources": ["quantity", "price"],
      "expr": "(item.quantity ?? 0) * (item.price ?? 0)"
    },
    {
      "kind": "compute",
      "target": "subtotal",
      "sources": ["items", "items.lineTotal"],
      "expr": "model.items.map((row) => row.lineTotal ?? 0).reduce((sum, value) => sum + value, 0)"
    },
    {
      "kind": "computeFrom",
      "target": "total",
      "sources": ["subtotal", "discount"],
      "expr": "Math.round((subtotal ?? 0) * (1 - (discount ?? 0) / 100) * 100) / 100"
    },
    {
      "kind": "enableWhen",
      "target": "discount",
      "sources": ["customerType"],
      "expr": "model.customerType === 'company'",
      "options": { "resetOnDisable": true }
    },
    { "kind": "transformValue", "target": "promoCode", "expr": "(value ?? '').toUpperCase()" },
    { "kind": "syncFields", "target": "receiptEmail", "sources": ["email"] },
    {
      "kind": "onChange",
      "target": "customerType",
      "expr": "if (value === 'person' && model.paymentMethod === 'invoice') model.paymentMethod = 'card';"
    },
    {
      "kind": "revalidateWhen",
      "target": "paymentMethod",
      "sources": ["customerType"],
      "expr": "form.paymentMethod.markAsTouched()"
    },
    { "kind": "exclusiveFlag", "target": "primary", "each": "recipients" },
    {
      "kind": "aggregateInto",
      "target": "recipients",
      "expr": "rows.length === 0 || rows.some((row) => row.primary) ? [] : [{ index: 0, patch: { primary: true } }]"
    },
    {
      "kind": "onComponentEvent",
      "selector": "wizard",
      "event": "onSubmit",
      "expr": "await submitOrder(model.get())"
    }
  ],
  "visibility": [],
  "dataSources": [
    {
      "name": "SOURCES",
      "values": [
        { "value": "search", "label": "Поиск" },
        { "value": "friends", "label": "Друзья" },
        { "value": "ads", "label": "Реклама" },
        { "value": "other", "label": "Другое" }
      ]
    }
  ],
  "operators": { "submitOrder": "./api" }
}
