    }
  ],
  "arrays": [
    {
      "path": "properties",
      "itemFields": [
        "type",
        "description",
        "estimatedValue",
        "hasEncumbrance"
      ]
    },
    {
      "path": "existingLoans",
      "itemFields": [
        "bank",
        "type",
        "amount",
        "remainingAmount",
        "monthlyPayment",
        "maturityDate"
      ]
    },
    {
      "path": "coBorrowers",
      "itemFields": [
        "personalData.lastName",
        "personalData.firstName",
        "personalData.middleName",
        "personalData.birthDate",
        "phone",
        "email",
        "relationship",
        "monthlyIncome"
      ]
    }
  ],
  "computed": [
    {
      "path": "interestRate",
      "sources": [
        "loanType",
        "registrationAddress.region",
        "hasProperty",
        "properties"
      ]
    },
    {
      "path": "monthlyPayment",
      "sources": [
        "loanAmount",
        "loanTerm",
        "interestRate"
      ]
    },
    {
      "path": "initialPayment",
      "sources": [
        "propertyValue",
        "loanType"
      ]
    },
    {
      "path": "fullName",
      "sources": [
        "personalData.lastName",
        "personalData.firstName",
        "personalData.middleName"
      ]
    },
    {
      "path": "age",
      "sources": [
        "personalData.birthDate"
      ]
    },
    {
      "path": "coBorrowersIncome",
      "sources": [
        "coBorrowers.monthlyIncome"
      ]
    },
    {
      "path": "totalIncome",
      "sources": [
        "monthlyIncome",
        "additionalIncome",
        "coBorrowersIncome"
      ]
    },
    {
      "path": "paymentToIncomeRatio",
      "sources": [
        "monthlyPayment",
        "totalIncome"
      ]
    }
  ],
  "sample": {
    "loanAmount": 1000000,
    "loanTerm": 12
  },
  "probes": [
    {
      "id": "defaults",
      "gate": true,
      "sample": false,
      "expect": {
        "values": {
          "loanType": "consumer"
        }
      }
    },
    {
      "id": "amount-lower-bound",
      "gate": true,
      "set": {
        "loanAmount": 49999
      },
      "expect": {
        "invalid": [
          "loanAmount"
        ]
      }
    },
    {
      "id": "amount-upper-bound",
      "set": {
        "loanAmount": 10000001
      },
      "expect": {
        "invalid": [
          "loanAmount"
        ]
      }
    },
    {
      "id": "term-lower-bound",
      "gate": true,
      "set": {
        "loanTerm": 5
      },
      "expect": {
        "invalid": [
          "loanTerm"
        ]
      }
    },
    {
      "id": "rate-computed",
      "gate": true,
      "expect": {
        "positive": [
          "interestRate"
        ]
      }
    },
    {
      "id": "monthly-payment-computed",
      "gate": true,
      "expect": {
        "expressions": [
          {
            "id": "monthlyPayment",
            "expression": "((rate, term) => (model.loanAmount * (rate * (1 + rate) ** term)) / ((1 + rate) ** term - 1))(model.interestRate / 12 / 100, model.loanTerm)",
            "tolerance": 1
          }
        ]
      }
    },
    {
      "id": "full-name-computed",
      "gate": true,
      "set": {
        "personalData.lastName": "Иванов",
        "personalData.firstName": "Иван",
        "personalData.middleName": "Иванович"
      },
      "expect": {
        "values": {
          "fullName": "Иванов Иван Иванович"
        }
      }
    },
    {
      "id": "array-grows",
      "gate": true,
      "set": {
        "properties": {
          "push": {}
        }
      },
      "expect": {
        "arrayLength": {
          "properties": 1
        }
      }
    }
  ]
}
