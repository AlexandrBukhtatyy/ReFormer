{
  "category": "renderers",
  "description": "renderer-react (FormRenderer по дереву схемы) и renderer-json (документ формата 2 + реестр). Проверяем и то, что target отсекает нерелевантное.",
  "tasks": [
    {
      "id": "renderer-react/schema",
      "task": "описать разметку формы деревом вместо JSX",
      "target": "renderer-react",
      "queries": ["schema tree instead of jsx", "form schema node tree", "render schema"],
      "expectAny": ["FormSchemaNode", "model: model.$."]
    },
    {
      "id": "renderer-react/mount",
      "task": "смонтировать форму из render-схемы",
      "target": "renderer-react",
      "queries": ["render the form bundle", "FormRenderer component", "mount render schema"],
      "expectAny": ["FormRenderer"]
    },
    {
      "id": "renderer-react/hide",
      "task": "скрыть узел разметки по условию",
      "target": "renderer-react",
      "queries": [
        "hide node conditionally in renderer",
        "conditional visibility renderer",
        "hideWhen"
      ],
      "expectAny": ["hideWhen", "setHidden"]
    },
    {
      "id": "renderer-json/schema",
      "task": "описать форму JSON-схемой",
      "target": "renderer-json",
      "queries": ["json form schema", "describe form as json", "json schema dsl"],
      "expectAny": ["$model", "$component", "root"]
    },
    {
      "id": "renderer-json/registry",
      "task": "связать имена компонентов из JSON с реальными React-компонентами",
      "target": "renderer-json",
      "queries": [
        "map component names to react components",
        "component registry json",
        "defineRegistry"
      ],
      "expectAny": ["defineRegistry", "reg.component"]
    },
    {
      "id": "renderer-json/data-source",
      "task": "подставить в select список опций из справочника",
      "target": "renderer-json",
      "queries": [
        "options from data source in json schema",
        "dataSource select options",
        "$dataSource"
      ],
      "expectAny": ["$dataSource"]
    },
    {
      "id": "renderer-json/mount",
      "task": "отрендерить форму из JSON-схемы",
      "target": "renderer-json",
      "queries": [
        "render form from json schema",
        "FormRenderer json document registry",
        "mount json form"
      ],
      "expectAny": ["<FormRenderer form="]
    },
    {
      "id": "renderer-json/array-component",
      "task": "какой компонент зарегистрировать под редактируемый массив в JSON-схеме",
      "target": "renderer-json",
      "queries": [
        "form array component renderer-json",
        "editable array section registry",
        "form-array"
      ],
      "expectAny": ["reg.component('FormArray'", "$component(FormArray)"]
    },
    {
      "id": "renderer-json/wizard-submit",
      "task": "получить значения формы в обработчике submit визарда",
      "target": "renderer-json",
      "queries": ["wizard onSubmit values", "form wizard submit json", "form-wizard"],
      "expectAny": ["model.get()"]
    },
    {
      "id": "renderer-json/readonly-field",
      "task": "сделать одно вычисляемое поле недоступным для ввода",
      "target": "renderer-json",
      "queries": ["readonly field renderer-json", "view mode read only", "cookbook"],
      "expectAny": [".disable()"]
    },
    {
      "id": "renderer-json/subform",
      "task": "поставить один и тот же блок адреса в JSON-схеме дважды",
      "target": "renderer-json",
      "queries": ["reuse a fragment in json schema", "sub-form part in json document", "$part"],
      "expectAny": ["$part("]
    },
    {
      "id": "renderers/assembly",
      "task": "собрать форму одним вызовом для рендерера",
      "target": "renderer-react",
      "queries": [
        "assemble form bundle for renderer",
        "createForm schema behavior validation",
        "form-bundle"
      ],
      "expectAny": ["createForm"]
    }
  ]
}
