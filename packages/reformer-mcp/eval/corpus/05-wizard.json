{
  "category": "wizard",
  "description": "Многошаговые формы: визард узлом схемы, поток шагов сборки, навигация, проверка шага и отправка, условный шаг.",
  "tasks": [
    {
      "id": "wizard/config",
      "task": "настроить многошаговую форму",
      "target": "core",
      "queries": ["multi step form setup", "wizard flow steps", "form wizard"],
      "expectAny": ["FormWizard", "FormFlow", "flow.steps"]
    },
    {
      "id": "wizard/step-guard",
      "task": "не пускать на следующий шаг, пока текущий невалиден",
      "target": "core",
      "queries": [
        "block next until current step valid",
        "step guard wizard",
        "validate step before next"
      ],
      "expectAny": ["validateStep", "flow.next", "next()"]
    },
    {
      "id": "wizard/final-validation",
      "task": "проверить все шаги перед отправкой",
      "target": "core",
      "queries": ["validate all steps before submit", "final validation wizard", "bundle.submit"],
      "expectAny": ["bundle.submit", "SubmitResult"]
    },
    {
      "id": "wizard/navigation",
      "task": "переключать шаги вперёд и назад",
      "target": "core",
      "queries": ["wizard navigation next back", "step navigation", "flow goTo step"],
      "expectAny": ["FormWizard", "goTo", "flow.next", "useFormFlow"]
    },
    {
      "id": "wizard/conditional-step",
      "task": "показывать шаг только при выполнении условия",
      "target": "core",
      "queries": ["show step only when condition", "conditional wizard step", "hidden step"],
      "expectAny": ["setHidden", "hideWhen"]
    },
    {
      "id": "wizard/step-node",
      "task": "описать шаг визарда узлом схемы",
      "target": "renderer-react",
      "queries": [
        "wizard step as schema node",
        "многошаговая форма renderer-react шаги в children"
      ],
      "expectAny": ["component: Step"]
    },
    {
      "id": "wizard/step-rules-key",
      "task": "связать шаг визарда с его правилами валидации",
      "target": "renderer-react",
      "queries": ["wizard step validation rules", "flow steps by selector", "form-wizard"],
      "expectAny": ["flow.steps", "{ id:"]
    }
  ]
}
